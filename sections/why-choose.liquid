{%- comment -%}
  ---------------------------------------------------------------------------
  Totterful / Hankie Pals — why choose us
  ---------------------------------------------------------------------------
  A heading over a row of value props: icon, title, a line or two of copy.

  The icons are drawn here in SVG rather than uploaded, so they inherit their
  colour from the block's settings, stay crisp at any size, cost no requests
  and cannot arrive as a stray PNG with a white box behind it. Eighteen of
  them, in one rounded style. A block can still take an uploaded image if none
  of them fits.

  Each icon is built from four classes — f fills in the main colour, a fills in
  the accent, s and sa stroke in those same two — so a two-tone icon is two
  colour settings and nothing else. They are scoped under .hp-why__ico, so
  those one-letter names cannot reach anything else on the page.

  No script. The hover lift is a transition and the drift is a keyframe, both
  dropped under prefers-reduced-motion.

  Sizes are px: Dawn's root font-size is 62.5%, so rem renders at 62.5% of its
  intended value; theme type sliders arrive via --font-body-scale and
  --font-heading-scale. Every setting carries a `| default:` so an instance
  that predates a setting cannot emit a half-formed CSS token.

  Column counts are literal in classes rather than a variable inside repeat(),
  so the emitted class says which layout is in force.
  ---------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign col_count = s.columns | default: '4'
  assign mobile_count = s.columns_mobile | default: '2'
  assign motion = s.motion | default: 'rise'
-%}

{% style %}
  .hp-why {
    --hp-body-scale: var(--font-body-scale, 1);
    --hp-heading-scale: var(--font-heading-scale, 1);
    background-color: var(--hp-bg);
    padding-block: var(--hp-pt) var(--hp-pb);
  }

  .hp-why__inner {
    max-width: var(--hp-max-width);
    margin-inline: auto;
    padding-inline: var(--hp-pad-x);
  }

  /* --- Section header ----------------------------------------------------- */
  .hp-why__header {
    max-width: var(--hp-header-width);
    margin-inline: var(--hp-header-mi);
    margin-block-end: var(--hp-header-gap);
    text-align: var(--hp-header-align);
  }

  .hp-why__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 600;
    font-size: calc(var(--hp-eyebrow-size) * var(--hp-body-scale));
    letter-spacing: var(--hp-eyebrow-tracking);
    text-transform: uppercase;
    color: var(--hp-eyebrow-color);
  }

  .hp-why__heading {
    margin: 0;
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(
      clamp(calc(var(--hp-heading-size) * 0.62), 3.6vw, var(--hp-heading-size))
      * var(--hp-heading-scale)
    );
    /* Tracking this wide is the look in the reference; it needs the line
       height opened up to match or the lines crowd. */
    letter-spacing: var(--hp-heading-tracking);
    line-height: 1.22;
    text-transform: var(--hp-heading-case);
    color: var(--hp-heading-color);
  }

  .hp-why__intro {
    margin: 16px 0 0;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 500;
    font-size: calc(var(--hp-intro-size) * var(--hp-body-scale));
    line-height: 1.5;
    color: var(--hp-intro-color);
  }

  /* --- Grid --------------------------------------------------------------- */
  .hp-why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--hp-row-gap) var(--hp-col-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hp-why--c2 .hp-why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hp-why--c3 .hp-why__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .hp-why--c4 .hp-why__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  .hp-why__item {
    display: flex;
    flex-direction: column;
    align-items: var(--hp-item-align);
    text-align: var(--hp-item-text);
    padding: var(--hp-item-pad);
    border-radius: var(--hp-item-radius);
    background: var(--hp-item-bg);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  /* --- Icon --------------------------------------------------------------- */
  /* No backdrop by default: the box shrinks to the icon and paints nothing,
     so "None" means none rather than a square in the backdrop colour. */
  .hp-why__figure {
    display: grid;
    place-items: center;
    margin: 0 0 var(--hp-icon-gap);
    /* Staggered so a row of icons breathes rather than bobbing in unison. */
    animation: hp-why-drift var(--hp-drift-speed) ease-in-out infinite;
    animation-delay: calc(var(--i) * var(--hp-drift-stagger));
  }

  .hp-why--pad-blob .hp-why__figure,
  .hp-why--pad-circle .hp-why__figure {
    width: var(--hp-pad-size);
    height: var(--hp-pad-size);
    background: var(--hp-pad-bg);
  }

  .hp-why--pad-blob .hp-why__figure {
    /* The pebble from the brand sheet: each edge's radius pair sums to 100%. */
    border-radius: 45% 55% 50% 50% / 55% 45% 55% 45%;
  }

  .hp-why--pad-circle .hp-why__figure { border-radius: 50%; }

  .hp-why__icon {
    display: block;
    width: var(--hp-icon-size);
    height: var(--hp-icon-size);
    object-fit: contain;
    transition: transform 260ms cubic-bezier(0.22, 0.7, 0.3, 1);
  }

  @keyframes hp-why-drift {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(calc(var(--hp-drift-distance) * -1)); }
  }

  /* The four ways an icon can be painted. Scoped under the svg, so these
     one-letter names cannot apply to anything else on the page. */
  .hp-why__ico { display: block; }
  .hp-why__ico .f { fill: var(--hp-ico); }
  .hp-why__ico .a { fill: var(--hp-ico-accent); }
  .hp-why__ico .s,
  .hp-why__ico .sa {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hp-why__ico .s { stroke: var(--hp-ico); }
  .hp-why__ico .sa { stroke: var(--hp-ico-accent); }

  /* --- Copy --------------------------------------------------------------- */
  .hp-why__title {
    margin: 0;
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(var(--hp-title-size) * var(--hp-heading-scale));
    letter-spacing: var(--hp-title-tracking);
    line-height: 1.3;
    text-transform: var(--hp-title-case);
    color: var(--hp-title-color);
  }

  .hp-why__text {
    margin: var(--hp-text-gap) 0 0;
    max-width: var(--hp-text-width);
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 500;
    font-size: calc(var(--hp-text-size) * var(--hp-body-scale));
    line-height: 1.55;
    color: var(--hp-text-color);
  }

  .hp-why__link {
    margin-block-start: 14px;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 700;
    font-size: calc(var(--hp-link-size) * var(--hp-body-scale));
    color: var(--hp-link-color);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .hp-why__link:focus-visible,
  .hp-why__item a:focus-visible {
    outline: 3px solid var(--hp-title-color);
    outline-offset: 3px;
  }

  /* --- Reveal on scroll ---------------------------------------------------
     The hidden start state exists only while the section carries
     hp-why--reveal, and the script drops that class the moment it cannot
     animate — no IntersectionObserver, reduced motion, or anything thrown. So
     the failure mode is the copy simply being there, never invisible.

     The stagger is not in here: the script sets it inline per column and clears
     it once the entrance is done, because a delay left in place would also hold
     up the hover transition on the last column by a third of a second. */
  .hp-why--reveal [data-reveal] {
    opacity: 0;
    transition:
      opacity var(--hp-reveal-dur) ease,
      transform var(--hp-reveal-dur) cubic-bezier(0.22, 0.7, 0.3, 1);
  }

  .hp-why--reveal.hp-why--rise [data-reveal] {
    transform: translateY(var(--hp-reveal-dist));
  }

  .hp-why--reveal.hp-why--pop [data-reveal] {
    transform: translateY(calc(var(--hp-reveal-dist) * 0.4)) scale(0.92);
  }

  .hp-why--reveal [data-reveal].is-in {
    opacity: 1;
    transform: none;
  }

  /* --- Hover ---------------------------------------------------------------
     Written after the reveal so that, at equal specificity, hovering a settled
     column still lifts it. Both are skipped on touch, where hover never ends. */
  @media (hover: hover) {
    .hp-why--lift .hp-why__item:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 30px -20px rgba(47, 51, 38, 0.5);
    }

    /* On the icon itself, not the box around it: the drift keyframes own that
       box's transform and would win against a hover rule. */
    .hp-why--icon-hover .hp-why__item:hover .hp-why__icon {
      transform: scale(1.09) rotate(-3deg);
    }
  }

  /* --- Tablet ------------------------------------------------------------- */
  @media screen and (max-width: 989px) {
    .hp-why--c3 .hp-why__grid,
    .hp-why--c4 .hp-why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* --- Phone -------------------------------------------------------------- */
  @media screen and (max-width: 749px) {
    .hp-why { padding-block: var(--hp-pt-mobile) var(--hp-pb-mobile); }

    .hp-why--m1 .hp-why__grid { grid-template-columns: minmax(0, 1fr); }

    .hp-why--m2 .hp-why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .hp-why__grid { gap: var(--hp-row-gap-mobile) var(--hp-col-gap-mobile); }

    /* Two across a phone leaves little room, so the fixed sizes above are
       restated as ceilings that narrow screens scale below. */
    .hp-why--m2.hp-why--pad-blob .hp-why__figure,
    .hp-why--m2.hp-why--pad-circle .hp-why__figure {
      width: min(var(--hp-pad-size), 22vw);
      height: min(var(--hp-pad-size), 22vw);
    }

    .hp-why--m2 .hp-why__icon {
      width: min(var(--hp-icon-size), 13vw);
      height: min(var(--hp-icon-size), 13vw);
    }

    .hp-why--m2 .hp-why__title {
      font-size: calc(clamp(11px, 3.4vw, var(--hp-title-size)) * var(--hp-heading-scale));
      letter-spacing: min(var(--hp-title-tracking), 0.08em);
      /* A long unbroken word would otherwise push the column past its track. */
      overflow-wrap: break-word;
    }

    .hp-why--m2 .hp-why__text {
      font-size: calc(clamp(11px, 3.2vw, var(--hp-text-size)) * var(--hp-body-scale));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-why__figure { animation: none; }
    .hp-why__item { transition: none; }
    .hp-why--lift .hp-why__item:hover { transform: none; }
    .hp-why__icon { transition: none; }
    .hp-why--icon-hover .hp-why__item:hover .hp-why__icon { transform: none; }

    /* The script also bails out here; this is the belt to that braces, and it
       is what holds if the stylesheet loads and the script does not. */
    .hp-why--reveal [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
{% endstyle %}

<section
  class="hp-why hp-why--c{{ col_count }} hp-why--m{{ mobile_count }} hp-why--pad-{{ s.icon_backdrop | default: 'none' }}{% if motion != 'none' %} hp-why--reveal hp-why--{{ motion }}{% endif %}{% if s.hover_lift %} hp-why--lift{% endif %}{% if s.icon_hover %} hp-why--icon-hover{% endif %}"
  style="
    --hp-bg: {{ s.background | default: '#FCFBF6' }};
    --hp-max-width: {{ s.max_width | default: 1280 }}px;
    --hp-pad-x: {{ s.padding_inline | default: 24 }}px;
    --hp-header-width: {{ s.header_width | default: 900 }}px;
    --hp-header-mi: {% if s.header_alignment == 'left' %}0 auto 0 0{% else %}auto{% endif %};
    --hp-header-align: {{ s.header_alignment | default: 'center' }};
    --hp-header-gap: {{ s.header_gap | default: 56 }}px;
    --hp-eyebrow-size: {{ s.eyebrow_size | default: 13 }}px;
    --hp-eyebrow-tracking: {{ s.eyebrow_tracking | default: 14 | divided_by: 100.0 }}em;
    --hp-eyebrow-color: {{ s.eyebrow_color | default: '#6B7056' }};
    --hp-heading-size: {{ s.heading_size | default: 40 }}px;
    --hp-heading-tracking: {{ s.heading_tracking | default: 10 | divided_by: 100.0 }}em;
    --hp-heading-case: {{ s.heading_case | default: 'uppercase' }};
    --hp-heading-color: {{ s.heading_color | default: '#2F3326' }};
    --hp-intro-size: {{ s.intro_size | default: 18 }}px;
    --hp-intro-color: {{ s.intro_color | default: '#5C6150' }};
    --hp-col-gap: {{ s.column_gap | default: 40 }}px;
    --hp-row-gap: {{ s.row_gap | default: 56 }}px;
    --hp-col-gap-mobile: {{ s.column_gap_mobile | default: 20 }}px;
    --hp-row-gap-mobile: {{ s.row_gap_mobile | default: 36 }}px;
    --hp-item-align: {% if s.item_alignment == 'left' %}flex-start{% else %}center{% endif %};
    --hp-item-text: {{ s.item_alignment | default: 'center' }};
    --hp-item-pad: {{ s.item_padding | default: 0 }}px;
    --hp-item-radius: {{ s.item_radius | default: 0 }}px;
    --hp-icon-size: {{ s.icon_size | default: 56 }}px;
    --hp-pad-size: {{ s.backdrop_size | default: 88 }}px;
    --hp-icon-gap: {{ s.icon_gap | default: 22 }}px;
    --hp-drift-distance: {{ s.drift_distance | default: 6 }}px;
    --hp-drift-speed: {{ s.drift_speed | default: 5 }}s;
    --hp-drift-stagger: {{ s.drift_stagger | default: 400 }}ms;
    --hp-reveal-dur: {{ s.reveal_duration | default: 600 }}ms;
    --hp-reveal-dist: {{ s.reveal_distance | default: 24 }}px;
    --hp-title-size: {{ s.title_size | default: 15 }}px;
    --hp-title-tracking: {{ s.title_tracking | default: 14 | divided_by: 100.0 }}em;
    --hp-title-case: {{ s.title_case | default: 'uppercase' }};
    --hp-text-size: {{ s.text_size | default: 16 }}px;
    --hp-text-gap: {{ s.text_gap | default: 14 }}px;
    --hp-text-width: {{ s.text_width | default: 280 }}px;
    --hp-link-size: {{ s.link_size | default: 14 }}px;
    --hp-pt: {{ s.padding_top | default: 96 }}px;
    --hp-pb: {{ s.padding_bottom | default: 96 }}px;
    --hp-pt-mobile: {{ s.padding_top_mobile | default: 64 }}px;
    --hp-pb-mobile: {{ s.padding_bottom_mobile | default: 64 }}px;
  "
  {{ section.shopify_attributes }}
>
  <hp-why-reveal
    class="hp-why__inner"
    data-stagger="{{ s.reveal_stagger | default: 110 }}"
    data-duration="{{ s.reveal_duration | default: 600 }}"
    data-replay="{% if s.reveal_replay %}true{% else %}false{% endif %}"
  >
    {%- if s.eyebrow != blank or s.heading != blank or s.intro != blank -%}
      <div class="hp-why__header" data-reveal>
        {%- if s.eyebrow != blank -%}
          <p class="hp-why__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <{{ s.heading_tag | default: 'h2' }} class="hp-why__heading">
            {{- s.heading | escape -}}
          </{{ s.heading_tag | default: 'h2' }}>
        {%- endif -%}

        {%- if s.intro != blank -%}
          <p class="hp-why__intro">{{ s.intro | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="hp-why__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li
            class="hp-why__item"
            data-reveal
            style="
              --i: {{ forloop.index0 }};
              --hp-ico: {{ b.icon_color | default: '#D88B6D' }};
              --hp-ico-accent: {{ b.icon_accent | default: '#FCFBF6' }};
              --hp-pad-bg: {{ b.backdrop_color | default: '#F7DDCD' }};
              --hp-item-bg: {{ b.card_color | default: 'transparent' }};
              --hp-title-color: {{ b.title_color | default: '#2F3326' }};
              --hp-text-color: {{ b.text_color | default: '#5C6150' }};
              --hp-link-color: {{ b.link_color | default: '#6B7056' }};
            "
            {{ block.shopify_attributes }}
          >
            {%- if b.image != blank -%}
              <span class="hp-why__figure">
                {{
                  b.image
                  | image_url: width: 240
                  | image_tag: loading: 'lazy', widths: '60, 88, 120, 176, 240', alt: '',
                    class: 'hp-why__icon'
                }}
              </span>
            {%- elsif b.icon != 'none' -%}
              <span class="hp-why__figure">
                <svg
                  class="hp-why__ico hp-why__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  {%- case b.icon -%}
                    {%- when 'heart' -%}
                      <path class="f" d="M12 21c-.42 0-.83-.15-1.14-.43C6.15 16.33 3 13.48 3 9.9 3 7.08 5.13 4.95 7.88 4.95c1.6 0 3.16.78 4.12 2.05.96-1.27 2.52-2.05 4.12-2.05C18.87 4.95 21 7.08 21 9.9c0 3.58-3.15 6.43-7.86 10.67-.31.28-.72.43-1.14.43z"/>
                    {%- when 'star' -%}
                      <path class="f" d="M12 3.2c.4 0 .77.23.95.6l2.02 4.1 4.52.66c.4.06.73.34.86.72.12.38.02.8-.27 1.08l-3.27 3.19.77 4.5c.07.4-.1.81-.43 1.05-.33.24-.77.27-1.13.08L12 16.96l-4.02 2.12c-.36.19-.8.16-1.13-.08a1.05 1.05 0 0 1-.43-1.05l.77-4.5-3.27-3.19a1.05 1.05 0 0 1-.27-1.08c.13-.38.46-.66.86-.72l4.52-.66 2.02-4.1c.18-.37.55-.6.95-.6z"/>
                    {%- when 'sparkle' -%}
                      <path class="f" d="M10.6 2.8c.36 0 .68.23.8.57l1.1 3.05c.27.74.85 1.32 1.6 1.59l3.05 1.1a.85.85 0 0 1 0 1.6l-3.05 1.1c-.75.27-1.33.85-1.6 1.6l-1.1 3.04a.85.85 0 0 1-1.6 0l-1.1-3.05a2.55 2.55 0 0 0-1.6-1.59l-3.04-1.1a.85.85 0 0 1 0-1.6l3.05-1.1c.74-.27 1.32-.85 1.59-1.6l1.1-3.04c.12-.34.44-.57.8-.57z"/>
                      <path class="f" d="M18.1 14.6c.2 0 .38.13.45.32l.46 1.27c.1.29.33.52.62.62l1.27.46a.48.48 0 0 1 0 .9l-1.27.46c-.29.1-.52.33-.62.62l-.46 1.27a.48.48 0 0 1-.9 0l-.46-1.27a1.08 1.08 0 0 0-.62-.62l-1.27-.46a.48.48 0 0 1 0-.9l1.27-.46c.29-.1.52-.33.62-.62l.46-1.27c.07-.19.25-.32.45-.32z"/>
                    {%- when 'cloud' -%}
                      <path class="f" d="M7.6 19.6a4.6 4.6 0 0 1-.72-9.14 5.7 5.7 0 0 1 10.76-.44 4.35 4.35 0 0 1-.44 9.58H7.6z"/>
                    {%- when 'leaf' -%}
                      <path class="f" d="M6 18c0-7.83 5.72-13.55 13.55-13.55 0 7.83-5.72 13.55-13.55 13.55z"/>
                      <path class="s" d="m4.2 19.8 1.8-1.8"/>
                      <path class="sa" stroke-width="1.6" d="M6.6 17.4 16.8 7.2"/>
                    {%- when 'droplet' -%}
                      <path class="f" d="M12 2.8c3.4 3.7 6.3 7 6.3 10.4a6.3 6.3 0 1 1-12.6 0c0-3.4 2.9-6.7 6.3-10.4z"/>
                    {%- when 'flower' -%}
                      <circle class="f" cx="12" cy="5.3" r="2.95"/>
                      <circle class="f" cx="18.4" cy="9.95" r="2.95"/>
                      <circle class="f" cx="15.95" cy="17.5" r="2.95"/>
                      <circle class="f" cx="8.05" cy="17.5" r="2.95"/>
                      <circle class="f" cx="5.6" cy="9.95" r="2.95"/>
                      <circle class="a" cx="12" cy="12" r="2.6"/>
                    {%- when 'sun' -%}
                      <circle class="f" cx="12" cy="12" r="4.8"/>
                      <path class="s" d="M12 2.6v1.8M12 19.6v1.8M4.35 12H2.55M21.45 12h-1.8M6.6 6.6 5.3 5.3M18.7 18.7l-1.3-1.3M6.6 17.4l-1.3 1.3M18.7 5.3l-1.3 1.3"/>
                    {%- when 'moon' -%}
                      <path class="f" d="M20.6 14.3A8.7 8.7 0 0 1 9.7 3.4a8.7 8.7 0 1 0 10.9 10.9z"/>
                      <path class="a" d="M17.6 3c.2 0 .37.13.43.32l.3.92c.06.18.2.32.38.38l.92.3a.45.45 0 0 1 0 .86l-.92.3a.68.68 0 0 0-.38.38l-.3.92a.45.45 0 0 1-.86 0l-.3-.92a.68.68 0 0 0-.38-.38l-.92-.3a.45.45 0 0 1 0-.86l.92-.3a.68.68 0 0 0 .38-.38l.3-.92A.45.45 0 0 1 17.6 3z"/>
                    {%- when 'smile' -%}
                      <circle class="f" cx="12" cy="12" r="9.2"/>
                      <circle class="a" cx="9.1" cy="10.4" r="1.2"/>
                      <circle class="a" cx="14.9" cy="10.4" r="1.2"/>
                      <path class="sa" d="M8.6 14.4a4.3 4.3 0 0 0 6.8 0"/>
                    {%- when 'bunny' -%}
                      <ellipse class="f" cx="9.3" cy="6.9" rx="1.75" ry="4" transform="rotate(-13 9.3 6.9)"/>
                      <ellipse class="f" cx="14.7" cy="6.9" rx="1.75" ry="4" transform="rotate(13 14.7 6.9)"/>
                      <circle class="f" cx="12" cy="15.4" r="5.9"/>
                      <circle class="a" cx="9.9" cy="14.4" r=".95"/>
                      <circle class="a" cx="14.1" cy="14.4" r=".95"/>
                      <path class="sa" d="M10.7 17.2a2.2 2.2 0 0 0 2.6 0"/>
                    {%- when 'paw' -%}
