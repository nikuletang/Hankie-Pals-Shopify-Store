    {
      "type": "range",
      "id": "mark_opacity",
      "label": "Sparkle strength",
      "unit": "%",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 60
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "panel_width",
      "label": "Panel width",
      "unit": "px",
      "min": 900,
      "max": 1400,
      "step": 20,
      "default": 1120,
      "info": "How wide the photo and copy are allowed to spread before the side Pals begin."
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Maximum content width",
      "unit": "px",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "default": 1320
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "unit": "px",
      "min": 28,
      "max": 88,
      "step": 2,
      "default": 52,
      "info": "Desktop size. Mobile scales down with it automatically."
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between photo and text",
      "unit": "px",
      "min": 16,
      "max": 160,
      "step": 4,
      "default": 72,
      "info": "Becomes the vertical gap once the panel stacks on smaller screens, capped at 40px."
    },
    {
      "type": "range",
      "id": "chip_size",
      "label": "Character circle size",
      "unit": "px",
      "min": 56,
      "max": 140,
      "step": 4,
      "default": 92
    },
    {
      "type": "range",
      "id": "photo_size",
      "label": "Main photo size",
      "unit": "px",
      "min": 280,
      "max": 620,
      "step": 10,
      "default": 430
    },
    {
      "type": "range",
      "id": "shadow_strength",
      "label": "Photo shadow",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
