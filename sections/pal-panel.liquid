{%- comment -%}
  ---------------------------------------------------------------------------
  Totterful / Hankie Pals — Pal panel
  ---------------------------------------------------------------------------
  A Pal-shaped panel that slides up over the section above it and holds this
  section's words in its body.

  Measured off the reference rather than guessed. Its shape is one full-width
  panel with an elliptical top: the top edge fitted an ellipse the width of the
  viewport, rising about 90% of a screen from its sides to its apex. That is
  two border radii, not an image and not a clip path.

  The Pal does not scale. Its top edge simply travels up as the page scrolls,
  which reads as rising. In the reference the section above holds perfectly
  still while it happens — its card sat at the same pixel for the whole entry —
  so the section above is pinned. A section cannot normally reach its sibling,
  but :has() can: the rule below pins whichever section this one follows.
  Where :has() is missing the panel still slides up, just over a section that
  scrolls away as usual.

  The face sits a fifth of a screen below the apex, and the copy a little over
  half the dome down, both as fractions of the dome's height — so one control
  moves the whole composition and keeps it in proportion.

  No script at all. Sizes are px or vh: Dawn's root font-size is 62.5%, so rem
  renders at 62.5% of its intended value. Every setting carries a `| default:`.
  ---------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'
-%}

{% style %}
  /* The script puts this on the section above while the Pal is on its way up,
     and takes it off once the Pal has covered the screen — so the page scrolls
     normally from there on. A sticky element sticks for as long as its
     containing block is in view, and here that is the whole of <main>, so
     without taking it off again the section above would stay pinned behind
     every section below it. */
  .hp-pp-pin {
    position: sticky;
    top: var(--hp-pp-pin-top, 0px);
    z-index: 0;
  }

  /* Above the pinned section, so it covers it on the way up. */
  .hp-pp-section {
    position: relative;
    z-index: 1;
  }

  hp-pal-panel { display: block; }

  .hp-pp {
    --hp-pp-heading-scale: var(--font-heading-scale, 1);
    --hp-pp-body-scale: var(--font-body-scale, 1);
    /* One value drives the outline, the padding and the face, so the mobile
       override below is a single line. */
    --hp-pp-c: var(--hp-pp-cap, 85vh);
    position: relative;
    background: var(--hp-pp-color, #CFE1B9);
    /* The dome. A horizontal radius of half the width makes the curve span the
       whole panel; the vertical radius is how far it rises. */
    border-start-start-radius: 50% var(--hp-pp-c);
    border-start-end-radius: 50% var(--hp-pp-c);
    padding-block: calc(var(--hp-pp-c) * var(--hp-pp-copy, 0.55))
                   var(--hp-pp-pb, 96px);
    padding-inline: 24px;
  }

  /* The hankie comes to a point at the bottom. A box of its own rather than a
     clip on the panel, because clipping the panel would take the ears off. */
  .hp-pp__tip {
    width: 100%;
    height: var(--hp-pp-tip, 0px);
    background: var(--hp-pp-color, #CFE1B9);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .hp-pp__gauge {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: var(--hp-pp-c);
    pointer-events: none;
  }

  /* --- The face ----------------------------------------------------------
     Laid out like the hankie itself: ears out at the sides, eyes with a
     highlight, cheeks outside them, and a muzzle below carrying the smile.
     Everything is placed as a percentage of the panel's width and a fraction
     of the dome's height, so the face holds its proportions and its place on
     the curve whatever the dome is set to. */
  .hp-pp__face {
    position: absolute;
    inset-inline: 0;
    top: calc(var(--hp-pp-c) * var(--hp-pp-face, 0.22));
    height: 0;
    pointer-events: none;
  }

  .hp-pp__face > * {
    position: absolute;
    transform: translate(-50%, -50%);
  }

  /* Ears sit up on the dome's shoulders and stand above its curve, which is
     why the panel does not clip its children. The rounded box still clips its
     own background, so the dome's edge stays exactly as measured. */
  .hp-pp__ear {
    top: var(--hp-pp-ear-y, -7vw);
    width: var(--hp-pp-ear-w, 7vw);
    aspect-ratio: 1 / var(--hp-pp-ear-len, 1.5);
    background: var(--hp-pp-ear, #2F3326);
    display: grid;
    place-items: center;
  }

  /* Three ears, three outlines. What separates them is where the weight sits
     and what the tilt pivots around: a cow's turns about its middle, a bunny's
     stands up from its base, and a dog's hangs from where it joins the head. */
  .hp-pp--ears-cow .hp-pp__ear {
    border-radius: 52% 48% 46% 54% / 60% 60% 40% 40%;
    transform-origin: 50% 50%;
  }

  .hp-pp--ears-bunny .hp-pp__ear {
    /* Narrow, tall, and rounded hard at the tip. */
    border-radius: 50% 50% 44% 56% / 40% 40% 60% 60%;
    transform-origin: 50% 100%;
  }

  .hp-pp--ears-dog .hp-pp__ear {
    /* Wider at the bottom than the top, so it reads as hanging rather than
       standing. */
    border-radius: 46% 54% 50% 50% / 26% 26% 74% 74%;
    transform-origin: 50% 0;
  }

  .hp-pp--ears-bunny .hp-pp__ear::after { border-radius: 50% 50% 46% 54% / 42% 42% 58% 58%; }

  .hp-pp--ears-dog .hp-pp__ear::after {
    border-radius: 46% 54% 50% 50% / 28% 28% 72% 72%;
    align-self: end;
    margin-block-end: 8%;
  }

  .hp-pp__ear--l {
    left: calc(50% - var(--hp-pp-ear-x, 17vw));
    transform: translate(-50%, -50%) rotate(calc(var(--hp-pp-ear-tilt, 18deg) * -1));
  }

  .hp-pp__ear--r {
    left: calc(50% + var(--hp-pp-ear-x, 17vw));
    transform: translate(-50%, -50%) rotate(var(--hp-pp-ear-tilt, 18deg));
  }

  .hp-pp__ear::after {
    content: "";
    width: 46%;
    height: 62%;
    background: var(--hp-pp-ear-in, #ECA883);
    border-radius: 50%;
  }

  .hp-pp__eye {
    top: 0;
    width: var(--hp-pp-eye, 5vw);
    aspect-ratio: 1;
    background: var(--hp-pp-ink, #2F3326);
    border-radius: 50%;
  }

  .hp-pp__eye--l { left: calc(50% - var(--hp-pp-eye-x, 11vw)); }
  .hp-pp__eye--r { left: calc(50% + var(--hp-pp-eye-x, 11vw)); }

  /* The catchlight, up and to the left, which is what stops the eyes reading
     as two holes. */
  .hp-pp__eye::after {
    content: "";
    position: absolute;
    left: 26%;
    top: 20%;
    width: 30%;
    aspect-ratio: 1;
    background: #FFFFFF;
    border-radius: 50%;
  }

  .hp-pp__cheek {
    top: calc(var(--hp-pp-eye, 5vw) * 0.95);
    width: var(--hp-pp-cheek-w, 4vw);
    aspect-ratio: 1;
    background: var(--hp-pp-cheek, #E8654B);
    border-radius: 50%;
  }

  .hp-pp__cheek--l { left: calc(50% - var(--hp-pp-cheek-x, 13vw)); }
  .hp-pp__cheek--r { left: calc(50% + var(--hp-pp-cheek-x, 13vw)); }

  .hp-pp__muzzle {
    left: 50%;
    top: calc(var(--hp-pp-eye, 5vw) * 1.25);
    width: var(--hp-pp-muzzle, 9vw);
    aspect-ratio: 1.25 / 1;
    background: var(--hp-pp-muzzle-c, #D7A06A);
    /* Lopsided, like the stitched patch on the hankie. */
    border-radius: 48% 52% 44% 56% / 54% 54% 46% 46%;
  }

  .hp-pp__nose {
    position: absolute;
    left: 50%;
    top: 16%;
    transform: translateX(-50%);
    width: 24%;
    aspect-ratio: 2.2 / 1;
    background: var(--hp-pp-ink, #2F3326);
    border-radius: 50%;
  }

  /* A bunny's nose is a diamond, not an oval. Cut rather than rotated: the
     nose is already using its transform to sit centred. */
  .hp-pp--nose-diamond .hp-pp__nose {
    width: 26%;
    aspect-ratio: 1 / 0.92;
    border-radius: 0;
    clip-path: polygon(50% 0, 100% 44%, 50% 100%, 0 44%);
  }

  .hp-pp__whiskers {
    top: calc(var(--hp-pp-eye, 5vw) * 1.38);
    width: 0;
    height: 0;
  }

  .hp-pp__whiskers--l { left: calc(50% - var(--hp-pp-muzzle, 9vw) * 0.44); }
  .hp-pp__whiskers--r { left: calc(50% + var(--hp-pp-muzzle, 9vw) * 0.44); }

  .hp-pp__whiskers i {
    position: absolute;
    top: 0;
    width: var(--hp-pp-whisker, 6vw);
    height: max(2px, 0.26vw);
    border-radius: 100vw;
    background: var(--hp-pp-ink, #2F3326);
  }

  /* Each side fans from the edge nearest the muzzle, so the three lines meet
     at the face rather than at the tips. */
  .hp-pp__whiskers--r i { left: 0; transform-origin: 0 50%; }
  .hp-pp__whiskers--l i { right: 0; transform-origin: 100% 50%; }

  .hp-pp__whiskers--r i:nth-child(1) { transform: rotate(-15deg); }
  .hp-pp__whiskers--r i:nth-child(3) { transform: rotate(15deg); }
  .hp-pp__whiskers--l i:nth-child(1) { transform: rotate(15deg); }
  .hp-pp__whiskers--l i:nth-child(3) { transform: rotate(-15deg); }

  /* The signature: a four-point sparkle sitting on the nose. */
  .hp-pp__sparkle {
    position: absolute;
    left: 63%;
    top: 4%;
    width: var(--hp-pp-sparkle, 26%);
    aspect-ratio: 1;
    background: var(--hp-pp-sparkle-c, #FFFFFF);
    clip-path: polygon(
      50% 0%, 60% 40%, 100% 50%, 60% 60%,
      50% 100%, 40% 60%, 0% 50%, 40% 40%
    );
  }

  /* Drawn as the bottom edge of a box rather than a filled shape, so it stays
     a line at any size instead of closing up into a dark blob. */
  .hp-pp__smile {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translateX(-50%);
    width: 44%;
    aspect-ratio: 2.4 / 1;
    border: 0 solid var(--hp-pp-ink, #2F3326);
    border-bottom-width: max(2px, 0.32vw);
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
  }

  /* A blink is a squash, not a fade: the eye keeps its width and loses its
     height for about a tenth of a second, which is what a real blink does.
     Both eyes carry the same animation with no delay, so they blink together. */
  .hp-pp--blink .hp-pp__eye {
    animation: hp-pp-blink var(--hp-pp-blink, 6s) infinite;
  }

  @keyframes hp-pp-blink {
    0%, 93%, 100% { transform: translate(-50%, -50%) scaleY(1); }
    95.5%, 96.5%  { transform: translate(-50%, -50%) scaleY(0.08); }
  }

  /* --- Copy --------------------------------------------------------------- */
  .hp-pp__inner {
    position: relative;
    z-index: 2;
    max-width: var(--hp-pp-measure, 860px);
    margin-inline: auto;
    text-align: center;
  }

  .hp-pp__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 600;
    font-size: calc(var(--hp-pp-eyebrow-size, 13px) * var(--hp-pp-body-scale));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--hp-pp-eyebrow-ink, #6B7056);
  }

  .hp-pp__heading {
    margin: 0;
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(
      clamp(calc(var(--hp-pp-size, 64px) * 0.44), 5.6vw, var(--hp-pp-size, 64px))
      * var(--hp-pp-heading-scale)
    );
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-transform: var(--hp-pp-case, none);
    color: var(--hp-pp-ink, #2F3326);
  }

  .hp-pp__text {
    margin: 20px auto 0;
    max-width: var(--hp-pp-text-measure, 560px);
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 500;
    font-size: calc(var(--hp-pp-text-size, 19px) * var(--hp-pp-body-scale));
    line-height: 1.5;
    color: var(--hp-pp-text-ink, #3F4630);
  }

  .hp-pp__cta {
    display: inline-block;
    margin-block-start: 30px;
    padding: 17px 38px;
    border-radius: var(--hp-pp-btn-radius, 999px);
    background: var(--hp-pp-btn-bg, #D88B6D);
    color: var(--hp-pp-btn-ink, #2F3326);
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(15px * var(--hp-pp-heading-scale));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    text-decoration: none;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .hp-pp__cta:hover { transform: translateY(-2px); filter: brightness(0.96); }

  .hp-pp__cta:focus-visible {
    outline: 3px solid var(--hp-pp-ink, #2F3326);
    outline-offset: 4px;
  }

  /* --- Stickers ----------------------------------------------------------
     Scattered around the copy, placed by percentage so they hold their spot
     as the panel changes height. Decorative, and hidden where the panel is too
     narrow for them to sit clear of the words. */
  .hp-pp__sticker {
    position: absolute;
    z-index: 1;
    width: var(--w);
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%) rotate(var(--r));
    pointer-events: none;
  }

  .hp-pp__sticker img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    .hp-pp {
      --hp-pp-c: var(--hp-pp-cap-mobile, 45vh);
      padding-block: calc(var(--hp-pp-c) * var(--hp-pp-copy, 0.55))
                     var(--hp-pp-pb-mobile, 64px);
      padding-inline: 18px;
    }

    .hp-pp__sticker { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-pp__cta { transition: none; }
    .hp-pp__cta:hover { transform: none; }
    .hp-pp--blink .hp-pp__eye { animation: none; }
  }
{% endstyle %}

<hp-pal-panel>
<div
  class="hp-pp hp-pp--ears-{{ s.ear_style | default: 'cow' }} hp-pp--nose-{{ s.nose_style | default: 'oval' }}{% if s.blink %} hp-pp--blink{% endif %}"
  style="
    --hp-pp-color: {{ s.pal_color | default: '#CFE1B9' }};
    --hp-pp-ink: {{ s.heading_color | default: '#2F3326' }};
    --hp-pp-text-ink: {{ s.text_color | default: '#3F4630' }};
    --hp-pp-eyebrow-ink: {{ s.eyebrow_color | default: '#6B7056' }};
    --hp-pp-cap: {{ s.dome_height | default: 85 }}vh;
    --hp-pp-cap-mobile: {{ s.dome_height_mobile | default: 45 }}vh;
    --hp-pp-face: {{ s.face_offset | default: 22 | divided_by: 100.0 }};
    --hp-pp-copy: {{ s.copy_offset | default: 55 | divided_by: 100.0 }};
    --hp-pp-eye: {{ s.eye_size | default: 5 }}vw;
    --hp-pp-eye-x: {{ s.eye_spread | default: 22 | divided_by: 2.0 }}vw;
    --hp-pp-ear: {{ s.ear_color | default: '#2F3326' }};
    --hp-pp-ear-in: {{ s.ear_inner_color | default: '#ECA883' }};
    --hp-pp-ear-w: {{ s.ear_size | default: 7 }}vw;
    --hp-pp-ear-x: {{ s.ear_spread | default: 44 | divided_by: 2.0 }}vw;
    --hp-pp-ear-y: {{ s.ear_lift | default: -7 }}vw;
    --hp-pp-ear-tilt: {{ s.ear_tilt | default: 18 }}deg;
    --hp-pp-ear-len: {{ s.ear_length | default: 150 | divided_by: 100.0 }};
    --hp-pp-cheek: {{ s.cheek_color | default: '#E8654B' }};
    --hp-pp-cheek-w: {{ s.cheek_size | default: 4 }}vw;
    --hp-pp-cheek-x: {{ s.cheek_spread | default: 34 | divided_by: 2.0 }}vw;
    --hp-pp-muzzle: {{ s.muzzle_size | default: 9 }}vw;
    --hp-pp-muzzle-c: {{ s.muzzle_color | default: '#D7A06A' }};
    --hp-pp-whisker: {{ s.whisker_length | default: 6 }}vw;
    --hp-pp-sparkle: {{ s.sparkle_size | default: 26 }}%;
    --hp-pp-sparkle-c: {{ s.sparkle_color | default: '#FFFFFF' }};
    --hp-pp-blink: {{ s.blink_every | default: 6 }}s;
    --hp-pp-tip: {{ s.tip_depth | default: 0 }}px;
    --hp-pp-pin-top: {{ s.pin_offset | default: 0 }}px;
    --hp-pp-measure: {{ s.measure | default: 860 }}px;
    --hp-pp-text-measure: {{ s.text_measure | default: 560 }}px;
    --hp-pp-eyebrow-size: {{ s.eyebrow_size | default: 13 }}px;
    --hp-pp-size: {{ s.heading_size | default: 64 }}px;
    --hp-pp-case: {{ s.heading_case | default: 'none' }};
    --hp-pp-text-size: {{ s.text_size | default: 19 }}px;
    --hp-pp-btn-bg: {{ s.button_background | default: '#D88B6D' }};
    --hp-pp-btn-ink: {{ s.button_text_color | default: '#2F3326' }};
    --hp-pp-btn-radius: {{ s.button_radius | default: 50 }}px;
    --hp-pp-pb: {{ s.padding_bottom | default: 96 }}px;
    --hp-pp-pb-mobile: {{ s.padding_bottom_mobile | default: 64 }}px;
  "
  {{ section.shopify_attributes }}
>
  <span class="hp-pp__gauge" aria-hidden="true"></span>

  {%- if s.show_face -%}
    <div class="hp-pp__face" aria-hidden="true">
      {%- if s.show_ears -%}
        <span class="hp-pp__ear hp-pp__ear--l"></span>
        <span class="hp-pp__ear hp-pp__ear--r"></span>
      {%- endif -%}

      {%- if s.show_cheeks -%}
        <span class="hp-pp__cheek hp-pp__cheek--l"></span>
        <span class="hp-pp__cheek hp-pp__cheek--r"></span>
      {%- endif -%}

      <span class="hp-pp__eye hp-pp__eye--l"></span>
      <span class="hp-pp__eye hp-pp__eye--r"></span>

      {%- if s.show_muzzle -%}
        {%- if s.nose_style == 'diamond' -%}
          <span class="hp-pp__whiskers hp-pp__whiskers--l"><i></i><i></i><i></i></span>
          <span class="hp-pp__whiskers hp-pp__whiskers--r"><i></i><i></i><i></i></span>
        {%- endif -%}

        <span class="hp-pp__muzzle">
          <span class="hp-pp__nose"></span>
          <span class="hp-pp__smile"></span>
          {%- if s.show_sparkle -%}
            <span class="hp-pp__sparkle"></span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {%- if b.image != blank -%}
      <span
        class="hp-pp__sticker"
        style="--x: {{ b.x | default: 12 }}%; --y: {{ b.y | default: 60 }}%; --w: {{ b.size | default: 110 }}px; --r: {{ b.rotate | default: 0 }}deg;"
        aria-hidden="true"
        {{ block.shopify_attributes }}
      >
        {{ b.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '110, 220, 330, 600', alt: '' }}
      </span>
    {%- elsif request.design_mode -%}
      <span
        class="hp-pp__sticker"
        style="--x: {{ b.x | default: 12 }}%; --y: {{ b.y | default: 60 }}%; --w: {{ b.size | default: 110 }}px; --r: 0deg;"
        {{ block.shopify_attributes }}
      >
        <span style="display:block;padding:10px 12px;border:2px dashed rgba(47,51,38,.45);border-radius:10px;background:rgba(252,251,246,.75);font:500 12px/1.2 system-ui,sans-serif;color:#2F3326;text-align:center">Pick an image</span>
      </span>
    {%- endif -%}
  {%- endfor -%}

  <div class="hp-pp__inner">
    {%- if s.eyebrow != blank -%}
      <p class="hp-pp__eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <{{ heading_tag }} class="hp-pp__heading">
        {{- s.heading | escape | newline_to_br -}}
      </{{ heading_tag }}>
    {%- endif -%}

    {%- if s.text != blank -%}
      <p class="hp-pp__text">{{ s.text | escape | newline_to_br }}</p>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      <a class="hp-pp__cta" href="{{ s.button_link | default: '#' }}">
        {{- s.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{%- if s.tip_depth > 0 -%}
  <div class="hp-pp__tip" aria-hidden="true"></div>
{%- endif -%}
</hp-pal-panel>

{%- if s.pin_previous -%}
  <script>
    (function () {
      if (customElements.get('hp-pal-panel')) return;

      customElements.define('hp-pal-panel', class extends HTMLElement {
        connectedCallback() {
          try {
            this.section = this.closest('.hp-pp-section');
            this.panel = this.querySelector('.hp-pp');
            if (!this.section || !this.panel) return;

            // A pinned section that never lets go is worse than no pin at all,
            // and reduced motion is a fair reason to skip the whole thing.
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            this.onScroll = this.onScroll.bind(this);
            this.update();
            window.addEventListener('scroll', this.onScroll, { passive: true });
            window.addEventListener('resize', this.onScroll, { passive: true });
          } catch (e) {
            this.release();
          }
        }

        disconnectedCallback() {
          window.removeEventListener('scroll', this.onScroll);
          window.removeEventListener('resize', this.onScroll);
          if (this.frame) cancelAnimationFrame(this.frame);
          this.release();
        }

        // Re-found each time: the theme editor rebuilds a section on every
        // change, and a class put on the old element goes with it.
        get previous() {
          var el = this.section.previousElementSibling;
          return el && el.classList ? el : null;
        }

        release() {
          var el = this.previous;
          if (el) el.classList.remove('hp-pp-pin');
        }

        onScroll() {
          if (this.frame) return;
          var self = this;
          this.frame = requestAnimationFrame(function () {
            self.frame = null;
            self.update();
          });
        }

        update() {
          var el = this.previous;
          if (!el) return;

          var pinTop = parseFloat(
            getComputedStyle(this.panel).getPropertyValue('--hp-pp-pin-top')
          ) || 0;

          // The screen is covered once the outline's shoulders — the lowest
          // point along its top edge, where it reaches full width — have
          // passed the pin line. Letting go at the head's apex instead would
          // release while the corners still showed the section behind.
          var gauge = this.querySelector('.hp-pp__gauge');
          var shoulder = gauge ? gauge.offsetHeight : 0;
          var top = this.panel.getBoundingClientRect().top;
          var covered = top + shoulder <= pinTop;

          el.classList.toggle('hp-pp-pin', !covered);
        }
      });
    })();
  </script>
{%- endif -%}

