{%- comment -%}
  ---------------------------------------------------------------------------
  Totterful / Hankie Pals — "The problem" blob cards
  ---------------------------------------------------------------------------
  An eyebrow pill, a display heading, and three organic blob cards.

  Typography and page width resolve to the THEME's own custom properties first
  (--font-heading-family, --font-body-family, --font-heading-weight). The
  fallbacks after each var() are the Totterful brand sheet's own faces, so the
  section still reads correctly if a theme does not publish those properties.

  Every selector is prefixed .hp-problem, and every per-instance value arrives
  as an inline custom property, so nothing here can reach another section.
  ---------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign motion = s.motion | default: 'pop'
-%}

{% style %}
  /* Sizes are in px on purpose. Dawn sets html { font-size: 62.5% }, so 1rem is
     10px there and every rem-based size renders at 62.5% of its intended value.
     px is immune to that. The theme's own type sliders still reach this section
     through --font-body-scale / --font-heading-scale below. */
  .hp-problem {
    --hp-body-scale: var(--font-body-scale, 1);
    --hp-heading-scale: var(--font-heading-scale, 1);
    background: var(--hp-bg);
    padding-block: var(--hp-pt) var(--hp-pb);
  }

  .hp-problem__inner {
    max-width: var(--hp-width);
    margin-inline: auto;
    padding-inline: clamp(16px, 3.5vw, 48px);
  }

  /* --- Eyebrow pill ------------------------------------------------------ */
  .hp-problem__pill {
    display: flex;
    justify-content: center;
    margin: 0 0 clamp(24px, 2.8vw, 40px);
  }

  .hp-problem__pill-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 1.4em;
    border: 1px solid var(--hp-pill-border);
    border-radius: 999px;
    background: var(--hp-pill-bg);
    box-shadow: 0 2px 8px rgba(47, 51, 38, 0.06);
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(clamp(12px, 0.95vw, 14px) * var(--hp-heading-scale));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-ink);
    line-height: 1;
  }

  .hp-problem__dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--hp-dot);
    flex: none;
  }

  /* --- Heading ----------------------------------------------------------- */
  .hp-problem__heading {
    margin: 0 auto;
    max-width: var(--hp-heading-width);
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(
      clamp(calc(var(--hp-heading-size) * 0.48), 5.2vw, var(--hp-heading-size))
      * var(--hp-heading-scale)
    );
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--hp-ink);
    text-align: center;
  }

  /* --- Blob grid --------------------------------------------------------- */
  .hp-problem__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 34px);
    margin-block-start: clamp(40px, 5vw, 76px);
    list-style: none;
    padding: 0;
  }

  .hp-problem__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--hp-card-bg);
    color: var(--hp-card-ink);
    /* Organic, deliberately lopsided — not a circle, not a rounded box. Each
       edge's radius pair sums to 100% so the browser never scales them back. */
    border-radius: 60% 40% 52% 48% / 48% 56% 44% 52%;
    box-shadow: 0 18px 44px -20px rgba(47, 51, 38, var(--hp-shadow));
    padding:
      calc(clamp(36px, 3.6vw, 54px) * var(--hp-card-scale))
      15%
      calc(clamp(40px, 4vw, 60px) * var(--hp-card-scale));
  }

  .hp-problem__card:nth-child(3n + 2) {
    border-radius: 42% 58% 46% 54% / 56% 44% 56% 44%;
  }

  .hp-problem__card:nth-child(3n) {
    border-radius: 52% 48% 62% 38% / 44% 58% 42% 56%;
  }

  /* --- Arriving on scroll -------------------------------------------------
     Keyframes rather than a transition, because every option worth having here
     overshoots: a bubble that stops dead at full size is not a bubble. A
     transition can only go from one value to another.

     The hidden start state exists only while the section carries
     hp-problem--reveal, and the script drops that class the moment it cannot
     animate — no IntersectionObserver, reduced motion, or anything thrown. The
     failure mode is the blobs simply being there, never invisible.

     The stagger is not in here: the script sets animation-delay per card. */
  hp-problem-reveal { display: block; }

  .hp-problem--reveal .hp-problem__card { opacity: 0; }

  .hp-problem--reveal .hp-problem__card.is-in {
    opacity: 1;
    /* both, so the first frame holds through the stagger delay rather than the
       card sitting at full size waiting for its turn. */
    animation: var(--hp-reveal-name) var(--hp-reveal-dur) cubic-bezier(0.22, 0.7, 0.3, 1) both;
  }

  .hp-problem--fade .hp-problem__card.is-in { --hp-reveal-name: hp-problem-fade; }
  .hp-problem--rise .hp-problem__card.is-in { --hp-reveal-name: hp-problem-rise; }
  .hp-problem--pop .hp-problem__card.is-in { --hp-reveal-name: hp-problem-pop; }
  .hp-problem--squish .hp-problem__card.is-in { --hp-reveal-name: hp-problem-squish; }
  .hp-problem--wobble .hp-problem__card.is-in { --hp-reveal-name: hp-problem-wobble; }

  @keyframes hp-problem-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes hp-problem-rise {
    from { opacity: 0; transform: translateY(var(--hp-reveal-dist)); }
    to { opacity: 1; transform: none; }
  }

  /* A bubble arriving: under size, a little past full, then settled. */
  @keyframes hp-problem-pop {
    0% { opacity: 0; transform: scale(0.72); }
    55% { opacity: 1; transform: scale(1.06); }
    78% { transform: scale(0.98); }
    100% { opacity: 1; transform: none; }
  }

  /* Squash and stretch: wide and flat on the way in, tall on the rebound. */
  @keyframes hp-problem-squish {
    0% { opacity: 0; transform: translateY(var(--hp-reveal-dist)) scale(0.58, 1.16); }
    45% { opacity: 1; transform: translateY(0) scale(1.14, 0.88); }
    68% { transform: scale(0.94, 1.07); }
    85% { transform: scale(1.03, 0.98); }
    100% { opacity: 1; transform: none; }
  }

  /* The blob finds its own shape as it lands. border-radius is deliberately
     absent from the last frame: with no 100% value of its own, the browser
     builds one from the underlying rule — so each card morphs to whichever of
     the three lopsided shapes its nth-child gave it, and adding a fourth shape
     up there needs no change down here. */
  @keyframes hp-problem-wobble {
    0% {
      opacity: 0;
      transform: scale(0.6) rotate(-9deg);
      border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    }
    40% {
      opacity: 1;
      transform: scale(1.09) rotate(4deg);
      border-radius: 70% 30% 34% 66% / 64% 60% 40% 36%;
    }
    70% { transform: scale(0.95) rotate(-2deg); }
    100% { opacity: 1; transform: none; }
  }

  /* --- Circular image ---------------------------------------------------- */
  .hp-problem__media {
    width: calc(clamp(120px, var(--hp-image-size), 340px) * var(--hp-card-scale));
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: rgba(252, 251, 246, 0.55);
    margin-block-end: calc(clamp(20px, 2vw, 32px) * var(--hp-card-scale));
    flex: none;
  }

  .hp-problem__media > img,
  .hp-problem__media > svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp-problem__media > svg {
    fill: rgba(47, 51, 38, 0.18);
    background: rgba(252, 251, 246, 0.7);
  }

  /* --- Card copy --------------------------------------------------------- */
  .hp-problem__title {
    margin: 0 0 0.6em;
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(clamp(18px, 1.65vw, 26px) * var(--hp-heading-scale) * var(--hp-card-scale));
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: inherit;
    text-wrap: balance;
  }

  .hp-problem__body {
    margin: 0;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-size: calc(clamp(15px, 1.2vw, 18px) * var(--hp-body-scale) * var(--hp-card-scale));
    line-height: 1.5;
    color: inherit;
  }

  .hp-problem__body > p {
    margin: 0;
  }

  .hp-problem__body > p + p {
    margin-block-start: 0.75em;
  }

  /* --- Tablet: 2 up, third centred beneath ------------------------------- */
  @media screen and (max-width: 1199px) and (min-width: 750px) {
    .hp-problem__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hp-problem__card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      width: min(100%, 440px);
      margin-inline: auto;
    }

    .hp-problem__card {
      padding-inline: 13%;
    }
  }

  /* --- Mobile: stacked --------------------------------------------------- */
  @media screen and (max-width: 749px) {
    .hp-problem {
      padding-block: var(--hp-pt-mobile) var(--hp-pb-mobile);
    }

    .hp-problem__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(24px, 5vw, 36px);
    }

    .hp-problem__card {
      width: min(100%, 400px);
      margin-inline: auto;
      padding: calc(44px * var(--hp-card-scale)) 14% calc(48px * var(--hp-card-scale));
    }

    .hp-problem__media {
      width: calc(min(210px, var(--hp-image-size)) * var(--hp-card-scale));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-problem--reveal .hp-problem__card,
    .hp-problem--reveal .hp-problem__card.is-in {
      opacity: 1;
      animation: none;
    }
  }
{% endstyle %}

<section
  class="hp-problem{% if motion != 'none' %} hp-problem--reveal hp-problem--{{ motion }}{% endif %}"
  style="
    --hp-bg: {{ s.background | default: '#FCFBF6' }};
    --hp-ink: {{ s.heading_color | default: '#2F3326' }};
    --hp-dot: {{ s.pill_dot_color | default: '#B5C99A' }};
    --hp-pill-bg: {{ s.pill_background | default: '#FCFBF6' }};
    --hp-pill-border: {{ s.pill_border_color | default: '#ECA883' }};
    --hp-width: {{ s.content_width | default: 1500 }}px;
    --hp-card-scale: {{ s.card_scale | default: 100 | divided_by: 100.0  }};
    --hp-heading-size: {{ s.heading_size | default: 56 }}px;
    --hp-image-size: {{ s.image_size | default: 64 }}%;
    --hp-shadow: {{ s.shadow_strength | default: 40 | divided_by: 200.0  }};
    --hp-heading-width: {{ s.heading_width | default: 26 }}ch;
    --hp-pt: {{ s.padding_top | default: 96 }}px;
    --hp-pb: {{ s.padding_bottom | default: 96 }}px;
    --hp-pt-mobile: {{ s.padding_top_mobile | default: 60 }}px;
    --hp-pb-mobile: {{ s.padding_bottom_mobile | default: 60 }}px;
    --hp-reveal-dur: {{ s.reveal_duration | default: 700 }}ms;
    --hp-reveal-dist: {{ s.reveal_distance | default: 26 }}px;
  "
>
  <div class="hp-problem__inner">
    {%- if s.eyebrow != blank -%}
      <p class="hp-problem__pill">
        <span class="hp-problem__pill-inner">
          <span class="hp-problem__dot" aria-hidden="true"></span>
          {{ s.eyebrow | default: 'The problem' | escape  }}
        </span>
      </p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="hp-problem__heading">{{ s.heading | default: 'They resist tissues and wipe on their sleeves.' | escape  }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <hp-problem-reveal
        data-stagger="{{ s.reveal_stagger | default: 130 }}"
        data-duration="{{ s.reveal_duration | default: 700 }}"
        data-replay="{% if s.reveal_replay %}true{% else %}false{% endif %}"
      >
      <ul class="hp-problem__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign alt = block.settings.image_alt | default: block.settings.image.alt
          -%}
          <li
            class="hp-problem__card"
            data-reveal
            style="--hp-card-bg: {{ block.settings.background }}; --hp-card-ink: {{ block.settings.text_color }};"
            {{ block.shopify_attributes }}
          >
            <div class="hp-problem__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 640
                  | image_tag:
                    loading: 'lazy',
                    widths: '180, 240, 320, 440, 640',
                    sizes: '(min-width: 1100px) 240px, (min-width: 750px) 220px, 180px',
                    alt: alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="hp-problem__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <div class="hp-problem__body">{{ block.settings.body }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      </hp-problem-reveal>
    {%- endif -%}
  </div>
</section>

<noscript>
  <style>
    .hp-problem--reveal .hp-problem__card { opacity: 1; }
  </style>
</noscript>

<script>
  (function () {
    if (customElements.get('hp-problem-reveal')) return;

    customElements.define('hp-problem-reveal', class extends HTMLElement {
      connectedCallback() {
        // Anything unexpected in here ends with the blobs on screen, never with
        // a section stuck at opacity 0.
        try {
          this.root = this.closest('.hp-problem');
          this.items = this.querySelectorAll('[data-reveal]');

          if (!this.root || !this.root.classList.contains('hp-problem--reveal')) return;
          if (!this.items.length) return this.revealAll();
          if (!('IntersectionObserver' in window)) return this.revealAll();
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return this.revealAll();
          }

          this.stagger = parseInt(this.dataset.stagger, 10) || 0;
          this.duration = parseInt(this.dataset.duration, 10) || 0;
          this.replay = this.dataset.replay === 'true';
          this.timers = [];

          this.observer = new IntersectionObserver(this.onIntersect.bind(this), {
            // Once the block is a little way in, rather than the instant its
            // first pixel appears.
            rootMargin: '0px 0px -12% 0px',
            threshold: 0
          });
          this.observer.observe(this);
        } catch (e) {
          this.revealAll();
        }
      }

      // The theme editor tears a section down and rebuilds it on every change,
      // so the observer has to go with it.
      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        this.clearTimers();
      }

      onIntersect(entries) {
        var self = this;
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            self.play();
            if (!self.replay && self.observer) self.observer.unobserve(self);
          } else if (self.replay) {
            self.reset();
          }
        });
      }

      play() {
        var self = this;
        this.clearTimers();

        Array.prototype.forEach.call(this.items, function (el, i) {
          var delay = i * self.stagger;
          el.style.animationDelay = delay + 'ms';
          el.classList.add('is-in');

          // Once this blob has arrived its delay has done its job. Left set, it
          // would hold back anything else that animates this card later.
          self.timers.push(window.setTimeout(function () {
            if (el.classList.contains('is-in')) el.style.animationDelay = '';
          }, delay + self.duration + 80));
        });
      }

      reset() {
        this.clearTimers();
        Array.prototype.forEach.call(this.items, function (el) {
          el.style.animationDelay = '';
          el.classList.remove('is-in');
        });
      }

      clearTimers() {
        if (!this.timers) return;
        this.timers.forEach(window.clearTimeout);
        this.timers = [];
      }

      // The class the hidden start state hangs off, so dropping it cannot leave
      // anything invisible.
      revealAll() {
        if (this.root) this.root.classList.remove('hp-problem--reveal');
      }
    });
  })();
</script>


{% schema %}
{
  "name": "Problem blobs",
  "tag": "div",
  "class": "hp-problem-section",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The problem",
      "info": "Displayed in uppercase."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "They resist tissues and wipe on their sleeves."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "unit": "px",
      "min": 28,
      "max": 88,
      "step": 2,
      "default": 56,
      "info": "Desktop size. Mobile scales down with it automatically."
    },
    {
      "type": "range",
      "id": "heading_width",
      "label": "Heading line length",
      "unit": "ch",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 26,
      "info": "Lower numbers force the heading onto more lines."
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "content_width",
      "label": "Maximum content width",
      "unit": "px",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "default": 1500
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "unit": "%",
      "min": 40,
      "max": 85,
      "step": 1,
      "default": 64,
      "info": "Share of the blob's inner width. 64% matches the Webflow reference."
    },
    {
      "type": "range",
      "id": "shadow_strength",
      "label": "Blob shadow",
      "unit": "%",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "info": "0 removes the shadow entirely."
    },
    {
      "type": "range",
      "id": "card_scale",
      "label": "Card content size",
      "unit": "%",
      "min": 80,
      "max": 150,
      "step": 5,
      "default": 100,
      "info": "Scales the photo, text and padding inside each blob. Raising it makes the blobs taller and more substantial."
    },
    { "type": "header", "content": "Motion" },
    {
      "type": "select",
      "id": "motion",
      "label": "How the blobs arrive",
      "options": [
        { "value": "pop", "label": "Pop — like a bubble" },
        { "value": "wobble", "label": "Wobble — the blob finds its shape" },
        { "value": "squish", "label": "Squish — squash and stretch" },
        { "value": "rise", "label": "Rise — up and in" },
        { "value": "fade", "label": "Fade" },
        { "value": "none", "label": "None" }
      ],
      "default": "pop",
      "info": "Plays when the section scrolls into view, one blob after the next. Skipped for anyone whose device asks for reduced motion."
    },
    {
      "type": "range",
      "id": "reveal_stagger",
      "label": "Gap between blobs",
      "unit": "ms",
      "min": 0,
      "max": 400,
      "step": 10,
      "default": 130,
      "info": "0 brings them all at once."
    },
    {
      "type": "range",
      "id": "reveal_duration",
      "label": "How long each takes",
      "unit": "ms",
      "min": 200,
      "max": 1600,
      "step": 50,
      "default": 700,
      "info": "Wobble and Squish have more to get through than Pop, so they want the longer end."
    },
    {
      "type": "range",
      "id": "reveal_distance",
      "label": "How far they travel",
      "unit": "px",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 26,
      "info": "Rise and Squish only."
    },
    {
      "type": "checkbox",
      "id": "reveal_replay",
      "label": "Play again on the way back",
      "default": false,
      "info": "Off plays once. On replays every time the section leaves and re-enters the screen."
    },
    { "type": "header", "content": "Colors" },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FCFBF6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading and eyebrow text",
      "default": "#2F3326"
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "Eyebrow pill background",
      "default": "#FCFBF6"
    },
    {
      "type": "color",
      "id": "pill_border_color",
      "label": "Eyebrow pill outline",
      "default": "#ECA883"
    },
    {
      "type": "color",
      "id": "pill_dot_color",
      "label": "Eyebrow dot",
      "default": "#B5C99A"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "unit": "px",
      "min": 0,
      "max": 180,
      "step": 4,
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "unit": "px",
      "min": 0,
      "max": 180,
      "step": 4,
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "unit": "px",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "unit": "px",
      "min": 0,
      "max": 140,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Problem card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Describes the image for screen readers. Leave blank to use the alt text saved on the image in Content > Files."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Problem title" },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>Describe the problem in a sentence or two.</p>"
        },
        {
