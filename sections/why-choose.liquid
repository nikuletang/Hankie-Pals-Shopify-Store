                      <path class="f" d="M17.9 2.8c.3 0 .55.25.55.55V7c0 .3-.25.55-.55.55h-3.65a.55.55 0 0 1-.39-.94l3.65-3.65a.55.55 0 0 1 .39-.16zM6.1 21.2a.55.55 0 0 1-.55-.55V17c0-.3.25-.55.55-.55h3.65a.55.55 0 0 1 .39.94l-3.65 3.65a.55.55 0 0 1-.39.16z"/>
                    {%- when 'shield' -%}
                      <path class="f" d="M12 2.4c.12 0 .24.02.35.06l6.6 2.47c.35.13.58.46.58.84v5.1c0 4.75-3.03 8.4-7.16 10.64a.9.9 0 0 1-.86 0C7.38 19.27 4.35 15.62 4.35 10.87v-5.1c0-.38.23-.71.58-.84l6.6-2.47c.11-.04.23-.06.35-.06z"/>
                      <path class="sa" d="m9 11.6 2.2 2.2 4-4.2"/>
                    {%- when 'scissors' -%}
                      <circle class="s" cx="7" cy="17.8" r="2.5"/>
                      <circle class="s" cx="17" cy="17.8" r="2.5"/>
                      <path class="s" d="M8.6 15.9 18.8 3.6M15.4 15.9 5.2 3.6"/>
                    {%- when 'gift' -%}
                      <path class="f" d="M4.4 11.6h15.2v7.9c0 .77-.63 1.4-1.4 1.4H5.8c-.77 0-1.4-.63-1.4-1.4z"/>
                      <path class="f" d="M3.6 7.3h16.8c.66 0 1.2.54 1.2 1.2v2.3H2.4V8.5c0-.66.54-1.2 1.2-1.2z"/>
                      <path class="a" d="M10.7 7.3h2.6v13.6h-2.6z"/>
                      <path class="s" d="M12 7.2c-1.3-3-2.6-4-3.8-3.4-1.1.6-.9 2.4 3.8 3.4zM12 7.2c1.3-3 2.6-4 3.8-3.4 1.1.6.9 2.4-3.8 3.4z"/>
                    {%- when 'pocket' -%}
                      <path class="f" d="M4.9 8.4h14.2l-1.25 10.8a2.1 2.1 0 0 1-2.09 1.86H8.24a2.1 2.1 0 0 1-2.09-1.86z"/>
                      <path class="s" d="M8.7 8.4V6.6a3.3 3.3 0 0 1 6.6 0v1.8"/>
                    {%- endcase -%}
                </svg>
              </span>
            {%- endif -%}

            {%- if b.title != blank -%}
              <h3 class="hp-why__title">{{ b.title | escape }}</h3>
            {%- endif -%}

            {%- if b.text != blank -%}
              <p class="hp-why__text">{{ b.text | escape | newline_to_br }}</p>
            {%- endif -%}

            {%- if b.link_label != blank and b.link_url != blank -%}
              <a class="hp-why__link" href="{{ b.link_url }}">{{ b.link_label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </hp-why-reveal>
</section>

{%- comment -%}
  Scripting off is the one case the script itself cannot answer for, so the
  start state is undone here instead.
{%- endcomment -%}
<noscript>
  <style>
    .hp-why--reveal [data-reveal] { opacity: 1; transform: none; }
  </style>
</noscript>

<script>
  (function () {
    if (customElements.get('hp-why-reveal')) return;

    customElements.define('hp-why-reveal', class extends HTMLElement {
      connectedCallback() {
        // Anything unexpected in here ends with the copy on screen, never with
        // a section stuck at opacity 0.
        try {
          this.root = this.closest('.hp-why');
          this.items = this.querySelectorAll('[data-reveal]');

          if (!this.root || !this.root.classList.contains('hp-why--reveal')) return;
          if (!this.items.length) return this.revealAll();

          if (!('IntersectionObserver' in window)) return this.revealAll();
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            return this.revealAll();
          }

          this.stagger = parseInt(this.dataset.stagger, 10) || 0;
          this.duration = parseInt(this.dataset.duration, 10) || 0;
          this.replay = this.dataset.replay === 'true';
          this.timers = [];

          this.observer = new IntersectionObserver(this.onIntersect.bind(this), {
            // Fires once the top of the block is a little way into the
            // viewport, rather than the instant its first pixel appears.
            rootMargin: '0px 0px -12% 0px',
            threshold: 0
          });
          this.observer.observe(this);
        } catch (e) {
          this.revealAll();
        }
      }

      // The theme editor tears a section down and rebuilds it on every change,
      // so the observer has to go with it.
      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        this.clearTimers();
      }

      onIntersect(entries) {
        var self = this;
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            self.play();
            if (!self.replay && self.observer) self.observer.unobserve(self);
          } else if (self.replay) {
            self.reset();
          }
        });
      }

      play() {
        var self = this;
        this.clearTimers();

        Array.prototype.forEach.call(this.items, function (el, i) {
          var delay = i * self.stagger;
          el.style.transitionDelay = delay + 'ms';
          el.classList.add('is-in');

          // Once this column has arrived its delay has done its job. Left set,
          // it would also postpone the hover transition by the same amount.
          self.timers.push(window.setTimeout(function () {
            if (el.classList.contains('is-in')) el.style.transitionDelay = '';
          }, delay + self.duration + 60));
        });
      }

      reset() {
        this.clearTimers();
        Array.prototype.forEach.call(this.items, function (el) {
          el.style.transitionDelay = '';
          el.classList.remove('is-in');
        });
      }

      // Drops the start state for good: with the class gone there is nothing
      // left to hide anything, whatever happens after.
      revealAll() {
        if (this.root) this.root.classList.remove('hp-why--reveal');
      }

      clearTimers() {
        (this.timers || []).forEach(window.clearTimeout);
        this.timers = [];
      }
    });
  })();
</script>

