    {
      "type": "range",
      "id": "eye_spread",
      "label": "Space between the eyes",
      "unit": "%",
      "min": 6,
      "max": 60,
      "step": 2,
      "default": 22
    },
    { "type": "header", "content": "The section above" },
    {
      "type": "checkbox",
      "id": "pin_previous",
      "label": "Hold the section above still",
      "default": true,
      "info": "Pins whatever sits directly above this one so the Pal rises over it, then lets go the moment the Pal has covered the screen, so the rest of the page scrolls normally. That section needs to be shorter than a screen or it will pin with its lower half cut off — the hero is the right size for it. With no script, or for anyone asking for reduced motion, nothing is pinned and the Pal simply slides up."
    },
