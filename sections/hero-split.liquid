{%- comment -%}
  ---------------------------------------------------------------------------
  Totterful / Hankie Pals — split hero
  ---------------------------------------------------------------------------
  Two panels side by side, each owning its own background. The left panel's
  artwork is a background on the left panel element itself, so it is confined
  there by construction rather than by a rule that has to be maintained — a
  background cannot paint outside the box it belongs to.

  No script. The CTA's offset is a margin, the overlay is a pseudo element, and
  the stacking on small screens is the grid collapsing.

  Sizes are px: Dawn's root font-size is 62.5%, so rem renders at 62.5% of its
  intended value; theme type sliders arrive via --font-body-scale and
  --font-heading-scale. Every setting carries a `| default:` so an instance that
  predates a setting cannot emit a half-formed CSS token.

  Every selector is prefixed .hp-hero and every per-instance value arrives as an
  inline custom property, so nothing here can reach another section.
  ---------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h1'

  # Mobile layout drives both a class and the image's sizes hint: kept split,
  # the photo is about half a phone wide, so asking for 100vw would fetch
  # roughly twice the pixels it can show.
  assign mobile_layout = s.mobile_layout | default: 'split'
  if mobile_layout == 'split'
    assign img_sizes = '(min-width: 900px) 48vw, 45vw'
  else
    assign img_sizes = '(min-width: 900px) 48vw, 100vw'
  endif
-%}

{% style %}
  .hp-hero {
    --hp-body-scale: var(--font-body-scale, 1);
    --hp-heading-scale: var(--font-heading-scale, 1);
    display: grid;
    grid-template-columns: var(--hp-split) minmax(0, 1fr);
    gap: var(--hp-gap);
    min-height: var(--hp-min-height);
    background-color: var(--hp-right-bg);
  }

  /* --- Left panel -------------------------------------------------------- */
  .hp-hero__left {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: var(--hp-align);
    background-color: var(--hp-left-bg);
    background-repeat: var(--hp-bg-repeat);
    background-size: var(--hp-bg-size);
    padding: var(--hp-pt) var(--hp-left-pad) var(--hp-pb);
    overflow: hidden;
  }

  /* Three stacked layers inside the left panel, ordered explicitly and all
     positive: decorative shapes, then the readability overlay, then the copy.
     The panel's overflow:hidden clips the shapes, so they are confined for the
     same reason the artwork is. */
  .hp-hero__blob,
  .hp-hero__dot {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    transform: translate(-50%, -50%);
  }

  .hp-hero__blob {
    width: var(--hp-blob-size);
    aspect-ratio: 1.15 / 1;
    left: var(--hp-blob-x);
    top: var(--hp-blob-y);
    background: var(--hp-blob-color);
    /* Lopsided, each edge's radius pair summing to 100% — the same shape
       language as the problem cards and the Pals photo. */
    border-radius: 58% 42% 47% 53% / 53% 46% 54% 47%;
  }

  .hp-hero__dot {
    width: var(--hp-dot-size);
    aspect-ratio: 1;
    left: var(--hp-dot-x);
    top: var(--hp-dot-y);
    background: var(--hp-dot-color);
    border-radius: 50%;
  }

  .hp-hero__left::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--hp-overlay);
    opacity: var(--hp-overlay-opacity);
    pointer-events: none;
  }

  .hp-hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  /* Eyebrow. Centred within the heading's own width rather than the whole
     panel, so it stays visually tied to the left-aligned heading.
     --hp-hero__dot is already the decorative circle, hence eyebrow-dot. */
  .hp-hero__eyebrow {
    margin: 0 0 clamp(16px, 1.8vw, 26px);
    max-width: var(--hp-heading-width);
    text-align: var(--hp-eyebrow-align);
  }

  .hp-hero__eyebrow-inner {
    /* The nudge is `left` on a relatively positioned box, not a transform:
       the float animation already owns transform, and `left` moves it by
       exactly the number set whatever the alignment above is doing. */
    position: relative;
    inset-inline-start: var(--hp-eyebrow-nudge);
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 1.4em;
    border: 1px solid var(--hp-eyebrow-border);
    border-radius: 999px;
    background: var(--hp-eyebrow-bg);
    box-shadow: 0 2px 8px rgba(47, 51, 38, 0.06);
    /* Family comes from a class rather than an inline property: the font
       stacks contain quotes, which cannot go inside a style attribute. */
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--hp-eyebrow-weight);
    font-size: calc(var(--hp-eyebrow-size) * var(--hp-heading-scale));
    letter-spacing: var(--hp-eyebrow-tracking);
    text-transform: var(--hp-eyebrow-case);
    color: var(--hp-eyebrow-color);
    line-height: 1;
    animation: hp-hero-float var(--hp-float-speed) ease-in-out infinite;
  }

  .hp-hero--eyebrow-body .hp-hero__eyebrow-inner {
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
  }

  .hp-hero__eyebrow-dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--hp-eyebrow-dot);
    flex: none;
  }

  /* Distance 0 leaves the keyframes running against no movement, which is the
     same as still — one setting, no separate switch to leave saved off. */
  @keyframes hp-hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(calc(var(--hp-float-distance) * -1)); }
  }

  .hp-hero__heading {
    margin: 0;
    max-width: var(--hp-heading-width);
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(
      clamp(calc(var(--hp-heading-size) * 0.46), 5.4vw, var(--hp-heading-size))
      * var(--hp-heading-scale)
    );
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--hp-heading-color);
    text-align: left;
  }

  .hp-hero__sub {
    margin: clamp(16px, 1.8vw, 28px) 0 0;
    max-width: var(--hp-sub-width);
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 500;
    font-size: calc(
      clamp(calc(var(--hp-sub-size) * 0.8), 1.7vw, var(--hp-sub-size))
      * var(--hp-body-scale)
    );
    line-height: 1.45;
    color: var(--hp-sub-color);
    text-align: left;
  }

  /* --- CTA ---------------------------------------------------------------
     The offset is a left margin on the button's own row, so the heading and
     subheading stay flush left and only the button steps in. */
  .hp-hero__cta-row {
    margin-block-start: clamp(28px, 3.2vw, 48px);
    margin-inline-start: var(--hp-cta-offset);
  }

  /* The button itself comes from assets/hp-button.css — shape, weight, shadow
     and states are the same everywhere on the site and are not this section's
     to change. What is left here is where it sits and how big it is. */

  /* --- Right panel ------------------------------------------------------- */
  /* The photo is the panel. No padding, no inset frame — the image fills the
     column edge to edge and the colour below is only ever seen if no image is
     set. The panel is a grid item, so its height is the row's. */
  .hp-hero__right {
    display: block;
    background-color: var(--hp-right-bg);
    overflow: hidden;
  }

  .hp-hero__figure {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  .hp-hero__figure img,
  .hp-hero__figure svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hp-img-position);
    border-radius: var(--hp-img-radius);
  }

  .hp-hero__figure svg {
    fill: rgba(47, 51, 38, 0.16);
    background: rgba(252, 251, 246, 0.6);
  }

  /* --- Tablet: hold two columns, ease everything in ---------------------- */
  @media screen and (max-width: 1199px) and (min-width: 900px) {
    .hp-hero { gap: clamp(0px, 1vw, 24px); }
    .hp-hero__cta-row { margin-inline-start: calc(var(--hp-cta-offset) * 0.45); }
  }

  /* --- Small screens: shared ---------------------------------------------
     True whichever way the panels go. Everything below this splits on the
     layout class, which the section element carries. */
  @media screen and (max-width: 899px) {
    .hp-hero__left {
      background-position: var(--hp-bg-position-mobile);
      padding: var(--hp-pt-mobile) var(--hp-left-pad-mobile) var(--hp-pb-mobile);
    }

    /* Flush beneath the subheading, and never stretched edge to edge. */
    .hp-hero__cta-row { margin-inline-start: 0; }
  }

  /* --- Stacked ----------------------------------------------------------- */
  @media screen and (max-width: 899px) {
    .hp-hero--mstack {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      gap: 0;
    }

    .hp-hero--mstack .hp-hero__cta {
      --hp-btn-pad-y: 16px;
      --hp-btn-pad-x: 32px;
    }

    /* Stacked, the image has no row height to fill, so its shape gives it one. */
    .hp-hero--mstack .hp-hero__figure { height: auto; }

    .hp-hero--mstack .hp-hero__figure img,
    .hp-hero--mstack .hp-hero__figure svg {
      height: auto;
      aspect-ratio: var(--hp-img-ratio-mobile);
    }
  }

  /* --- Split, held side by side ------------------------------------------
     The copy now lives in a fraction of a phone, so the panel keeps its own
     minimum height and the padding is capped against the viewport: the
     desktop-sized setting would otherwise eat more width than the words. */
  @media screen and (max-width: 899px) {
    .hp-hero--msplit {
      grid-template-columns: var(--hp-split-mobile) minmax(0, 1fr);
      min-height: var(--hp-min-height-mobile);
      gap: 0;
    }

    .hp-hero--msplit .hp-hero__left {
      padding-inline: min(var(--hp-left-pad-mobile), 6vw);
    }
  }

  /* Phones. The desktop type clamps are tied to the viewport, which says
     nothing about how wide this column is, so each one is restated against a
     mobile ceiling of its own. Sized so the heading still breaks into words
     rather than fragments at 360px. */
  @media screen and (max-width: 749px) {
    .hp-hero--msplit .hp-hero__heading {
      font-size: calc(clamp(18px, 7.4vw, var(--hp-heading-size-mobile)) * var(--hp-heading-scale));
      line-height: 1.08;
      /* A long unbroken word — a name, a URL — would otherwise push the
         column wider than its track and squeeze the photo. */
      overflow-wrap: break-word;
    }

    .hp-hero--msplit .hp-hero__sub {
      margin-block-start: 12px;
      font-size: calc(clamp(11px, 3.4vw, var(--hp-sub-size-mobile)) * var(--hp-body-scale));
      line-height: 1.4;
    }

    .hp-hero--msplit .hp-hero__eyebrow { margin-block-end: 12px; }

    .hp-hero--msplit .hp-hero__eyebrow-inner {
      max-width: 100%;
      gap: 0.4em;
      padding: 0.55em 0.9em;
      font-size: calc(clamp(9px, 2.9vw, var(--hp-eyebrow-size)) * var(--hp-heading-scale));
      /* Tracking that reads as airy across a desktop panel is just lost
         width here. */
      letter-spacing: min(var(--hp-eyebrow-tracking), 0.06em);
      line-height: 1.25;
    }

    .hp-hero--msplit .hp-hero__cta-row { margin-block-start: 18px; }

    /* Half a phone screen wide: the pill has to give up padding and tracking
       before it gives up the label. */
    .hp-hero--msplit .hp-hero__cta {
      --hp-btn-pad-y: 13px;
      --hp-btn-pad-x: 18px;
      --hp-btn-size: clamp(11px, 3vw, 14px);
      --hp-btn-drop: 3px;
      max-width: 100%;
      letter-spacing: 0.04em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-hero__eyebrow-inner { animation: none; }
  }

  {%- if s.left_image != blank -%}
    [data-hp-hero="{{ section.id }}"] .hp-hero__left {
      background-image: url("{{ s.left_image | image_url: width: 1400 }}");
      background-position: {{ s.bg_position | default: 'center center' }};
    }
  {%- endif -%}
{% endstyle %}

{%- comment -%}
  The button lives in assets/hp-button.css so there is one of it on the site.
  A duplicate link on a page that already loaded it costs nothing: the browser
  fetches the file once and applies it once.
{%- endcomment -%}
{{ 'hp-button.css' | asset_url | stylesheet_tag }}

<section
  class="hp-hero hp-hero--m{{ mobile_layout }}{% if s.eyebrow_font == 'body' %} hp-hero--eyebrow-body{% endif %}"
  data-hp-hero="{{ section.id }}"
  style="
    --hp-split: {{ s.column_split | default: 55 }}%;
    --hp-gap: {{ s.column_gap | default: 0 }}px;
    --hp-min-height: {{ s.min_height | default: 620 }}px;
    --hp-split-mobile: {{ s.column_split_mobile | default: 55 }}%;
    --hp-min-height-mobile: {{ s.min_height_mobile | default: 460 }}px;
    --hp-left-bg: {{ s.left_bg_color | default: '#FCFBF6' }};
    --hp-right-bg: {{ s.right_bg_color | default: '#CFE1B9' }};
    --hp-bg-size: {{ s.bg_size | default: 'cover' }};
    --hp-bg-repeat: {{ s.bg_repeat | default: 'no-repeat' }};
    --hp-bg-position-mobile: {{ s.bg_position_mobile | default: 'center center' }};
    --hp-blob-color: {{ s.blob_color | default: '#F3DCD0' }};
    --hp-blob-size: {{ s.blob_size | default: 70 }}%;
    --hp-blob-x: {{ s.blob_x | default: 32 }}%;
    --hp-blob-y: {{ s.blob_y | default: 50 }}%;
    --hp-dot-color: {{ s.dot_color | default: '#CFE1B9' }};
    --hp-dot-size: {{ s.dot_size | default: 13 }}%;
    --hp-dot-x: {{ s.dot_x | default: 72 }}%;
    --hp-dot-y: {{ s.dot_y | default: 16 }}%;
    --hp-overlay: {{ s.overlay_color | default: '#FCFBF6' }};
    --hp-overlay-opacity: {{ s.overlay_opacity | default: 0 | divided_by: 100.0 }};
    --hp-align: {{ s.content_alignment | default: 'center' }};
    --hp-left-pad: {{ s.left_padding | default: 88 }}px;
    --hp-left-pad-mobile: {{ s.left_padding_mobile | default: 24 }}px;
    --hp-eyebrow-align: {{ s.eyebrow_alignment | default: 'center' }};
    --hp-eyebrow-size: {{ s.eyebrow_size | default: 13 }}px;
    --hp-eyebrow-weight: {% if s.eyebrow_weight == blank or s.eyebrow_weight == 'theme' %}var(--font-heading-weight, 700){% else %}{{ s.eyebrow_weight | default: 700 }}{% endif %};
    --hp-eyebrow-tracking: {{ s.eyebrow_tracking | default: 12 | divided_by: 100.0 }}em;
    --hp-eyebrow-case: {{ s.eyebrow_case | default: 'uppercase' }};
    --hp-eyebrow-nudge: {{ s.eyebrow_nudge | default: 0 }}px;
    --hp-eyebrow-color: {{ s.eyebrow_color | default: '#2F3326' }};
    --hp-eyebrow-bg: {{ s.eyebrow_background | default: '#FCFBF6' }};
    --hp-eyebrow-border: {{ s.eyebrow_border_color | default: '#ECA883' }};
    --hp-eyebrow-dot: {{ s.eyebrow_dot_color | default: '#B5C99A' }};
    --hp-float-distance: {{ s.float_distance | default: 8 }}px;
    --hp-float-speed: {{ s.float_speed | default: 4 }}s;
    --hp-heading-color: {{ s.heading_color | default: '#2F3326' }};
    --hp-heading-width: {{ s.heading_max_width | default: 560 }}px;
    --hp-heading-size: {{ s.heading_size | default: 76 }}px;
    --hp-heading-size-mobile: {{ s.heading_size_mobile | default: 30 }}px;
    --hp-sub-color: {{ s.subheading_color | default: '#5C6150' }};
    --hp-sub-width: {{ s.subheading_max_width | default: 440 }}px;
    --hp-sub-size: {{ s.subheading_size | default: 22 }}px;
    --hp-sub-size-mobile: {{ s.subheading_size_mobile | default: 14 }}px;
    --hp-cta-offset: {{ s.button_offset | default: 180 }}px;
    --hp-img-ratio-mobile: {{ s.image_ratio_mobile | default: '4 / 5' }};
    --hp-img-position: {{ s.image_position | default: 'center' }};
    --hp-img-radius: {{ s.image_radius | default: 0 }}px;
    --hp-pt: {{ s.padding_top | default: 96 }}px;
    --hp-pb: {{ s.padding_bottom | default: 96 }}px;
    --hp-pt-mobile: {{ s.padding_top_mobile | default: 56 }}px;
    --hp-pb-mobile: {{ s.padding_bottom_mobile | default: 56 }}px;
  "
>
  <div class="hp-hero__left">
    <span class="hp-hero__blob" aria-hidden="true"></span>
    <span class="hp-hero__dot" aria-hidden="true"></span>

    <div class="hp-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="hp-hero__eyebrow">
          <span class="hp-hero__eyebrow-inner">
            <span class="hp-hero__eyebrow-dot" aria-hidden="true"></span>
            {{ s.eyebrow | escape }}
          </span>
        </p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <{{ heading_tag }} class="hp-hero__heading">
          {{- s.heading | escape | newline_to_br -}}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <p class="hp-hero__sub">{{ s.subheading | escape | newline_to_br }}</p>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <div class="hp-hero__cta-row">
          <a
            class="hp-btn hp-btn--lg hp-hero__cta"
            href="{{ s.button_link | default: '#' }}"
            style="
              --hp-btn-bg: {{ s.btn_fill | default: '#ECA883' }};
              --hp-btn-ink: {{ s.btn_ink | default: '#2F3326' }};
              --hp-btn-line: {{ s.btn_line | default: '#2F3326' }};
            "
          >
            {{- s.button_label | escape -}}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="hp-hero__right">
    <figure class="hp-hero__figure">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '400, 560, 720, 900, 1200',
            sizes: img_sizes,
            alt: s.image_alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Split hero",
  "tag": "div",
  "class": "hp-hero-section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "New from Totterful",
      "info": "Shown in uppercase in a small pill above the heading. Leave empty to hide it."
    },
    {
      "type": "select",
      "id": "eyebrow_alignment",
      "label": "Eyebrow position",
      "options": [
        { "value": "center", "label": "Centred over the heading" },
        { "value": "left", "label": "Flush left with the heading" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "eyebrow_font",
      "label": "Eyebrow font",
      "options": [
        { "value": "heading", "label": "Heading font" },
        { "value": "body", "label": "Body font" }
      ],
      "default": "heading",
      "info": "Both come from the theme's own type settings, so a custom font set there applies here too."
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "unit": "px",
      "min": 9,
      "max": 28,
      "step": 1,
      "default": 13
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Eyebrow weight",
      "options": [
        { "value": "theme", "label": "Theme default" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "theme",
      "info": "A weight the font does not actually have gets faked by the browser, which looks smeared. Stick to weights you uploaded."
    },
    {
      "type": "range",
      "id": "eyebrow_tracking",
      "label": "Eyebrow letter spacing",
      "unit": "%",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "info": "Percent of the font size. Wide tracking suits uppercase; drop it near 0 for sentence case."
    },
    {
      "type": "select",
      "id": "eyebrow_case",
      "label": "Eyebrow case",
      "options": [
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "none", "label": "As typed" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "eyebrow_nudge",
      "label": "Eyebrow nudge",
      "unit": "px",
      "min": -200,
      "max": 200,
      "step": 5,
      "default": 0,
      "info": "Fine-tunes the position set above. Negative moves it left, positive right."
    },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow text", "default": "#2F3326" },
    { "type": "color", "id": "eyebrow_background", "label": "Eyebrow background", "default": "#FCFBF6" },
    { "type": "color", "id": "eyebrow_border_color", "label": "Eyebrow outline", "default": "#ECA883" },
    { "type": "color", "id": "eyebrow_dot_color", "label": "Eyebrow dot", "default": "#B5C99A" },
    {
      "type": "range",
      "id": "float_distance",
      "label": "Eyebrow float distance",
      "unit": "px",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8,
      "info": "How far it drifts up and back. 0 keeps it still."
    },
    {
      "type": "range",
      "id": "float_speed",
      "label": "Eyebrow float speed",
      "unit": "s",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "info": "Seconds for one full up-and-down. Higher is slower."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A nose wipe your toddler will actually use."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1 — use on the home page" },
        { "value": "h2", "label": "H2 — if another section already has the H1" }
      ],
      "default": "h1"
    },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#2F3326" },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "unit": "px",
      "min": 32,
      "max": 110,
      "step": 2,
      "default": 76,
      "info": "Desktop size. Mobile scales down with it automatically."
