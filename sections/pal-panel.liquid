      "step": 2,
      "default": 26,
      "info": "Share of the muzzle."
    },
    {
      "type": "range",
      "id": "muzzle_size",
      "label": "Muzzle size",
      "unit": "%",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "dome_height",
