{%- comment -%}
  ---------------------------------------------------------------------------
  Totterful / Hankie Pals — "Meet the Pals" character picker
  ---------------------------------------------------------------------------
  A row of characters; picking one swaps the photo, tint, copy and buy button.

  ONE product, one variant per Pal. The product is chosen once on the section;
  each Pal block finds its own variant by matching the Pal's name against the
  variant's option value, so naming the variants after the characters is all the
  wiring there is. A Pal with no matching variant falls back to its link, which
  is what makes this work before the product exists.

  The picker is a radio group, so switching is CSS only. Because a panel is
  display:none until its radio is checked, the entrance animation restarts every
  time you pick a Pal without a line of script.

  Sizes are px: Dawn's root font-size is 62.5%, so rem renders at 62.5% of its
  intended value. Theme type sliders arrive via --font-body-scale and
  --font-heading-scale instead.

  Every selector is prefixed .hp-pals and every per-instance value arrives as an
  inline custom property, so nothing here can reach another section.
  ---------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign pal_product = s.product
-%}

{% style %}
  .hp-pals {
    --hp-body-scale: var(--font-body-scale, 1);
    --hp-heading-scale: var(--font-heading-scale, 1);
    position: relative;
    /* background-color, not the shorthand: the pattern rule below sets
       background-image and the shorthand would reset it. */
    background-color: var(--hp-bg);
    padding-block: var(--hp-pt) var(--hp-pb);
  }


  .hp-pals__inner {
    position: relative;
    max-width: var(--hp-width);
    margin-inline: auto;
    padding-inline: clamp(16px, 3.5vw, 48px);
  }

  /* --- Eyebrow + heading ------------------------------------------------- */
  .hp-pals__eyebrow {
    display: flex;
    justify-content: center;
    margin: 0 0 clamp(20px, 2.4vw, 32px);
  }

  .hp-pals__eyebrow-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 1.4em;
    border: 1px solid var(--hp-pill-border);
    border-radius: 999px;
    background: var(--hp-pill-bg);
    box-shadow: 0 2px 8px rgba(47, 51, 38, 0.06);
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(clamp(12px, 0.95vw, 14px) * var(--hp-heading-scale));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hp-ink);
    line-height: 1;
  }

  .hp-pals__dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--hp-dot);
    flex: none;
  }

  .hp-pals__heading {
    margin: 0 auto;
    max-width: 28ch;
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(
      clamp(calc(var(--hp-heading-size) * 0.5), 4.4vw, var(--hp-heading-size))
      * var(--hp-heading-scale)
    );
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--hp-ink);
    text-align: center;
  }

  .hp-pals__intro {
    margin: clamp(14px, 1.4vw, 20px) auto 0;
    max-width: 52ch;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-size: calc(clamp(15px, 1.2vw, 18px) * var(--hp-body-scale));
    line-height: 1.55;
    color: var(--hp-muted);
    text-align: center;
  }

  .hp-pals__intro > p { margin: 0; }
  .hp-pals__intro > p + p { margin-block-start: 0.6em; }

  /* --- The radios: off-screen but still focusable ------------------------ */
  .hp-pals__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* --- Chip row ---------------------------------------------------------- */
  .hp-pals__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(12px, 1.6vw, 28px);
    margin-block-start: clamp(32px, 3.6vw, 56px);
  }

  .hp-pals__chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    padding: 6px;
    border-radius: 24px;
    transition: transform 160ms ease;
  }

  .hp-pals__chip:hover { transform: translateY(-3px); }

  .hp-pals__chip-face {
    width: var(--hp-chip-size);
    height: var(--hp-chip-size);
    border-radius: 50%;
    overflow: hidden;
    background: var(--hp-pal-tint);
    box-shadow: 0 6px 16px -8px rgba(47, 51, 38, 0.4);
    transition: box-shadow 180ms ease, transform 180ms ease;
  }

  .hp-pals__chip-face > img,
  .hp-pals__chip-face > svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp-pals__chip-face > svg {
    fill: rgba(47, 51, 38, 0.18);
    background: rgba(252, 251, 246, 0.7);
  }

  .hp-pals__chip-name {
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(clamp(14px, 1.05vw, 17px) * var(--hp-heading-scale));
    color: var(--hp-muted);
    line-height: 1;
    transition: color 160ms ease;
  }

  /* --- Stage ------------------------------------------------------------- */
  .hp-pals__stage { margin-block-start: clamp(32px, 4vw, 60px); }

  /* fr tracks, not auto: the photo's own width is a percentage, and a
     percentage inside a content-sized track collapses both columns. */
  .hp-pals__panel {
    display: none;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: var(--hp-gap);
    max-width: min(100%, 1060px);
    margin-inline: auto;
  }

  .hp-pals__photo {
    position: relative;
    width: min(100%, var(--hp-photo-size));
    margin-inline-start: auto;
    aspect-ratio: 1 / 1;
    background: var(--hp-pal-tint);
    border-radius: 58% 42% 51% 49% / 47% 55% 45% 53%;
    overflow: hidden;
    box-shadow: 0 20px 48px -22px rgba(47, 51, 38, var(--hp-shadow));
  }

  .hp-pals__photo > img,
  .hp-pals__photo > svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hp-pals__photo > svg {
    fill: rgba(47, 51, 38, 0.16);
    background: transparent;
  }

  /* --- Copy column ------------------------------------------------------- */
  .hp-pals__name {
    margin: 0;
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(clamp(30px, 3.4vw, 52px) * var(--hp-heading-scale));
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--hp-ink);
  }

  .hp-pals__trait {
    margin: clamp(8px, 0.8vw, 14px) 0 0;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 600;
    font-size: calc(clamp(17px, 1.5vw, 23px) * var(--hp-body-scale));
    line-height: 1.35;
    color: var(--hp-accent-ink);
  }

  /* The Pal talking. Tail on the lower left, so it reads as speech. */
  .hp-pals__quote {
    position: relative;
    display: inline-block;
    margin: clamp(16px, 1.6vw, 24px) 0 0;
    padding: 15px 24px;
    max-width: 38ch;
    background: var(--hp-pal-tint);
    border-radius: 24px 24px 24px 6px;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 500;
    font-size: calc(clamp(16px, 1.3vw, 20px) * var(--hp-body-scale));
    line-height: 1.45;
    color: var(--hp-ink);
  }

  .hp-pals__body {
    margin: clamp(14px, 1.4vw, 22px) 0 0;
    max-width: 46ch;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-size: calc(clamp(15px, 1.2vw, 18px) * var(--hp-body-scale));
    line-height: 1.55;
    color: var(--hp-muted);
  }

  .hp-pals__body > p { margin: 0; }
  .hp-pals__body > p + p { margin-block-start: 0.7em; }

  /* --- Actions ----------------------------------------------------------- */
  .hp-pals__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-block-start: clamp(20px, 2vw, 30px);
  }

  .hp-pals__form { margin: 0; }

  .hp-pals__button {
    display: inline-block;
    padding: 15px 34px;
    border: 0;
    border-radius: 999px;
    background: var(--hp-btn-bg);
    color: var(--hp-btn-ink);
    font-family: var(--font-heading-family, "Chubbo", "Alata", Georgia, serif);
    font-weight: var(--font-heading-weight, 700);
    font-size: calc(clamp(15px, 1.1vw, 17px) * var(--hp-heading-scale));
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: transform 160ms ease, filter 160ms ease;
  }

  .hp-pals__button:hover {
    transform: translateY(-2px);
    filter: brightness(0.96);
  }

  .hp-pals__button[disabled],
  .hp-pals__button[aria-busy="true"] {
    cursor: not-allowed;
  }

  .hp-pals__button[disabled] {
    background: var(--hp-pal-tint);
    color: var(--hp-muted);
  }

  .hp-pals__button[disabled]:hover,
  .hp-pals__button[aria-busy="true"]:hover {
    transform: none;
    filter: none;
  }

  .hp-pals__button[aria-busy="true"] { opacity: 0.75; }

  .hp-pals__price {
    font-weight: 400;
    opacity: 0.85;
  }

  .hp-pals__link {
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-weight: 600;
    font-size: calc(clamp(15px, 1.1vw, 17px) * var(--hp-body-scale));
    color: var(--hp-ink);
    text-underline-offset: 4px;
  }

  /* --- Closing line ------------------------------------------------------ */
  .hp-pals__footnote {
    margin: clamp(36px, 4vw, 64px) auto 0;
    max-width: 46ch;
    font-family: var(--font-body-family, "Quicksand", ui-rounded, system-ui, sans-serif);
    font-size: calc(clamp(15px, 1.2vw, 18px) * var(--hp-body-scale));
    line-height: 1.55;
    color: var(--hp-muted);
    text-align: center;
  }

  .hp-pals__footnote a {
    color: var(--hp-ink);
    text-underline-offset: 3px;
  }

  /* --- Motion -----------------------------------------------------------
     A panel is display:none until its radio is checked, so these re-run every
     time a Pal is picked. No script, no state to reset. */
  @keyframes hp-pals-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes hp-pals-swell {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: none; }
  }

  /* The blob never settles — it drifts between four shapes, slowly. */
  @keyframes hp-pals-morph {
    0%, 100% { border-radius: 58% 42% 51% 49% / 47% 55% 45% 53%; }
    25% { border-radius: 45% 55% 62% 38% / 56% 44% 56% 44%; }
    50% { border-radius: 62% 38% 44% 56% / 42% 58% 42% 58%; }
    75% { border-radius: 50% 50% 57% 43% / 59% 41% 59% 41%; }
  }

  .hp-pals--motion .hp-pals__photo {
    animation:
      hp-pals-swell 560ms cubic-bezier(0.2, 0.7, 0.3, 1) both,
      hp-pals-morph var(--hp-drift) ease-in-out 560ms infinite;
  }

  .hp-pals--motion .hp-pals__copy > * {
    animation: hp-pals-rise 520ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
  }

  .hp-pals--motion .hp-pals__copy > *:nth-child(1) { animation-delay: 80ms; }
  .hp-pals--motion .hp-pals__copy > *:nth-child(2) { animation-delay: 150ms; }
  .hp-pals--motion .hp-pals__copy > *:nth-child(3) { animation-delay: 220ms; }
  .hp-pals--motion .hp-pals__copy > *:nth-child(4) { animation-delay: 290ms; }
  .hp-pals--motion .hp-pals__copy > *:nth-child(5) { animation-delay: 360ms; }

  {%- if s.background_image != blank -%}
    {%- assign fade = 100 | minus: s.background_opacity | times: 0.01 -%}
    {%- assign wash = s.background | color_modify: 'alpha', fade -%}
    [data-hp-pals="{{ section.id }}"] {
      background-image:
        linear-gradient({{ wash }}, {{ wash }}),
        url("{{ s.background_image | image_url: width: 1600 }}");
      background-position: center, center;
      background-repeat: repeat, repeat;
      background-size: auto, {{ s.background_tile_size | default: 240 }}px auto;
    }

    [data-hp-pals="{{ section.id }}"].hp-pals--cover {
      background-repeat: no-repeat, no-repeat;
      background-size: cover, cover;
      background-attachment: scroll, scroll;
    }
  {%- endif -%}

  /* --- Per-Pal state ----------------------------------------------------- */
  {%- for block in section.blocks -%}
    {%- assign k = block.id -%}
    .hp-pals__radio[data-pal="{{ k }}"]:checked ~ .hp-pals__stage .hp-pals__panel[data-pal="{{ k }}"] {
      display: grid;
    }

    .hp-pals__radio[data-pal="{{ k }}"]:checked ~ .hp-pals__chips .hp-pals__chip[data-pal="{{ k }}"] .hp-pals__chip-face {
      transform: scale(1.06);
      box-shadow:
        0 0 0 4px var(--hp-bg),
        0 0 0 8px var(--hp-pal-tint),
        0 10px 22px -10px rgba(47, 51, 38, 0.45);
    }

    .hp-pals__radio[data-pal="{{ k }}"]:checked ~ .hp-pals__chips .hp-pals__chip[data-pal="{{ k }}"] .hp-pals__chip-name {
      color: var(--hp-ink);
    }

    .hp-pals__radio[data-pal="{{ k }}"]:focus-visible ~ .hp-pals__chips .hp-pals__chip[data-pal="{{ k }}"] {
      outline: 3px solid var(--hp-ink);
      outline-offset: 3px;
    }
  {%- endfor -%}

  @media screen and (max-width: 989px) {
    .hp-pals__panel {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      text-align: center;
    }

    .hp-pals__photo { margin-inline: auto; }

    .hp-pals__panel { gap: min(var(--hp-gap), 40px); }

    .hp-pals__body,
    .hp-pals__actions {
      justify-content: center;
      margin-inline: auto;
    }

    .hp-pals__quote { border-radius: 24px; }
  }

  @media screen and (max-width: 749px) {
    .hp-pals {
      padding-block: var(--hp-pt-mobile) var(--hp-pb-mobile);
    }

    /* One scrolling row rather than a wrapped grid of half-rows. */
    .hp-pals__chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-block-end: 8px;
      margin-inline: calc(clamp(16px, 3.5vw, 48px) * -1);
      padding-inline: clamp(16px, 3.5vw, 48px);
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }

    .hp-pals__chip {
      flex: none;
      scroll-snap-align: center;
    }

    .hp-pals__chip:hover { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-pals--motion .hp-pals__photo,
    .hp-pals--motion .hp-pals__copy > * {
      animation: none;
    }

    .hp-pals__chip,
    .hp-pals__chip-face,
    .hp-pals__chip-name,
    .hp-pals__button {
      transition: none;
    }

    .hp-pals__chip:hover,
    .hp-pals__button:hover {
      transform: none;
    }
  }
{% endstyle %}

<section
  id="hp-pals-{{ section.id }}"
  data-hp-pals="{{ section.id }}"
  class="hp-pals{% if s.enable_motion != false %} hp-pals--motion{% endif %}{% unless s.background_repeat %} hp-pals--cover{% endunless %}"
  style="
    --hp-bg: {{ s.background | default: '#FCFBF6' }};
    --hp-ink: {{ s.heading_color | default: '#2F3326' }};
    --hp-muted: {{ s.body_color | default: '#5C6150' }};
    --hp-accent-ink: {{ s.trait_color | default: '#6B7056' }};
    --hp-dot: {{ s.pill_dot_color | default: '#B5C99A' }};
    --hp-pill-bg: {{ s.pill_background | default: '#FCFBF6' }};
    --hp-pill-border: {{ s.pill_border_color | default: '#ECA883' }};
    --hp-btn-bg: {{ s.button_background | default: '#D88B6D' }};
    --hp-btn-ink: {{ s.button_text_color | default: '#2F3326' }};
    --hp-width: {{ s.content_width | default: 1320 }}px;
    --hp-heading-size: {{ s.heading_size | default: 52 }}px;
    --hp-chip-size: {{ s.chip_size | default: 92 }}px;
    --hp-photo-size: {{ s.photo_size | default: 430 }}px;
    --hp-shadow: {{ s.shadow_strength | default: 40 | divided_by: 200.0  }};
    --hp-drift: {{ s.drift_speed | default: 18 }}s;
    --hp-gap: {{ s.column_gap | default: 72 }}px;
    --hp-pt: {{ s.padding_top | default: 96 }}px;
    --hp-pb: {{ s.padding_bottom | default: 96 }}px;
    --hp-pt-mobile: {{ s.padding_top_mobile | default: 60 }}px;
    --hp-pb-mobile: {{ s.padding_bottom_mobile | default: 60 }}px;
  "
>
  <div class="hp-pals__inner">
    {%- if s.eyebrow != blank -%}
      <p class="hp-pals__eyebrow">
        <span class="hp-pals__eyebrow-inner">
          <span class="hp-pals__dot" aria-hidden="true"></span>
          {{ s.eyebrow | default: 'Meet the Pals' | escape  }}
        </span>
      </p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="hp-pals__heading">{{ s.heading | default: 'Every Hankie Pal has a name.' | escape  }}</h2>
    {%- endif -%}

    {%- if s.intro != blank -%}
      <div class="hp-pals__intro">{{ s.intro | default: '<p>Ask a toddler for the fox one and you will get a blank look. Ask for Pip and you will get a hand held out.</p>' }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hp-pals__picker">
        {%- for block in section.blocks -%}
          {%- assign uid = 'Pal-' | append: section.id | append: '-' | append: block.id -%}
          <input
            class="hp-pals__radio"
            type="radio"
            name="hp-pals-{{ section.id }}"
            id="{{ uid }}"
            data-pal="{{ block.id }}"
            {% if forloop.first %}checked{% endif %}
          >
        {%- endfor -%}

        <div class="hp-pals__chips">
          {%- for block in section.blocks -%}
            {%- liquid
              assign uid = 'Pal-' | append: section.id | append: '-' | append: block.id
              assign face = block.settings.avatar | default: block.settings.image
            -%}
            <label
              class="hp-pals__chip"
              for="{{ uid }}"
              data-pal="{{ block.id }}"
              style="--hp-pal-tint: {{ block.settings.color }};"
              {{ block.shopify_attributes }}
            >
              <span class="hp-pals__chip-face">
                {%- if face != blank -%}
                  {{
                    face
                    | image_url: width: 320
                    | image_tag: loading: 'lazy', widths: '80, 120, 160, 240, 320', sizes: '120px', alt: ''
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </span>
              <span class="hp-pals__chip-name">{{ block.settings.name | escape }}</span>
            </label>
          {%- endfor -%}
        </div>

        <div class="hp-pals__stage">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings

              # Find this Pal's variant. The Pal's name is the match by default,
              # so naming variants after the characters is the whole setup; the
              # override exists for when a variant is spelled differently.
              assign wanted = b.variant_name | default: b.name | downcase | strip
              assign pal_variant = false
              if pal_product != blank and wanted != blank
                for v in pal_product.variants
                  assign v_title = v.title | downcase | strip
                  assign v_option = v.option1 | downcase | strip
                  if v_title == wanted or v_option == wanted
                    assign pal_variant = v
                    break
                  endif
                endfor
              endif

              assign photo = b.image | default: pal_variant.image | default: pal_product.featured_image
              assign alt = b.image_alt | default: photo.alt | default: b.name
              assign form_id = 'PalBuy-' | append: section.id | append: '-' | append: block.id
            -%}
            <div
              class="hp-pals__panel"
              data-pal="{{ block.id }}"
              style="--hp-pal-tint: {{ b.color }};"
            >
              <div class="hp-pals__photo">
                {%- if photo != blank -%}
                  {{
                    photo
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 560, 720, 1000',
                      sizes: '(min-width: 990px) 46vw, 90vw',
                      alt: alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </div>

              <div class="hp-pals__copy">
                {%- if b.name != blank -%}
                  <h3 class="hp-pals__name">{{ b.name | escape }}</h3>
                {%- endif -%}

                {%- if b.trait != blank -%}
                  <p class="hp-pals__trait">{{ b.trait | escape }}</p>
                {%- endif -%}

                {%- if b.quote != blank -%}
                  <p class="hp-pals__quote">{{ b.quote | escape }}</p>
                {%- endif -%}

                {%- if b.body != blank -%}
                  <div class="hp-pals__body">{{ b.body }}</div>
                {%- endif -%}

                <div class="hp-pals__actions">
                  {%- if pal_variant -%}
                    {%- if pal_variant.available -%}
                      {%- form 'product', pal_product, id: form_id, class: 'hp-pals__form' -%}
                        <input type="hidden" name="id" value="{{ pal_variant.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit" class="hp-pals__button">
                          {{ s.buy_label | default: 'Buy now' | escape  }}
                          {%- if s.show_price %}
                            <span class="hp-pals__price">· {{ pal_variant.price | money }}</span>
                          {%- endif -%}
                        </button>
                      {%- endform -%}
                    {%- else -%}
                      <button type="button" class="hp-pals__button" disabled>
                        {{ s.sold_out_label | default: 'Back soon' | escape  }}
                      </button>
                    {%- endif -%}

                    {%- if b.link != blank and b.link_label != blank -%}
                      <a class="hp-pals__link" href="{{ b.link }}">{{ b.link_label | escape }}</a>
                    {%- endif -%}
                  {%- elsif b.link != blank and b.link_label != blank -%}
                    <a class="hp-pals__button" href="{{ b.link }}">{{ b.link_label | escape }}</a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if s.footnote != blank -%}
      <div class="hp-pals__footnote">{{ s.footnote | default: '<p>More Pals on the way. Waitlist members get to vote on who comes next.</p>' }}</div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('hp-pals-{{ section.id }}');
    if (!root) return;

    /* Editor only: clicking a Pal block in the sidebar opens that Pal's panel. */
    if (window.Shopify && window.Shopify.designMode) {
      document.addEventListener('shopify:block:select', function (event) {
        var radio = root.querySelector('.hp-pals__radio[data-pal="' + event.detail.blockId + '"]');
        if (radio) radio.checked = true;
      });
    }

    /* Add to cart without leaving the page, then open the theme's cart drawer.
       Every early return below leaves the form to submit normally, which lands
       on the cart page — so this still works with JS off, or on a theme that
       has no drawer. */
    root.addEventListener('submit', function (event) {
      var form = event.target.closest('.hp-pals__form');
      if (!form) return;

      var drawer = document.querySelector('cart-drawer');
      if (!drawer || typeof drawer.renderContents !== 'function') return;

      event.preventDefault();

      var button = form.querySelector('button[type="submit"]');
      if (button) {
        button.setAttribute('aria-busy', 'true');
        button.disabled = true;
      }

      var body = new FormData(form);
      body.append('sections', 'cart-drawer,cart-icon-bubble');
      body.append('sections_url', window.location.pathname);

      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { Accept: 'application/javascript' },
        body: body
      })
        .then(function (response) { return response.json(); })
        .then(function (data) {
          if (data.status) throw new Error(data.description || data.message);
          drawer.classList.remove('is-empty');
          drawer.renderContents(data);
        })
        .catch(function () {
          window.location = '{{ routes.cart_url }}';
        })
        .finally(function () {
          if (button) {
            button.removeAttribute('aria-busy');
            button.disabled = false;
          }
        });
    });
  })();
</script>

