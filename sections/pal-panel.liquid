    { "type": "color", "id": "text_color", "label": "Text", "default": "#3F4630" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#6B7056" },
    { "type": "checkbox", "id": "show_face", "label": "Show the face", "default": true },
