    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#FCFBF6" },
    { "type": "color", "id": "heading_color", "label": "Heading and names", "default": "#2F3326" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#5C6150" },
    {
      "type": "color",
      "id": "trait_color",
      "label": "Personality line",
      "default": "#6B7056",
      "info": "The one-liner under each Pal's name."
    },
    { "type": "color", "id": "pill_background", "label": "Eyebrow pill background", "default": "#FCFBF6" },
    { "type": "color", "id": "pill_border_color", "label": "Eyebrow pill outline", "default": "#ECA883" },
    { "type": "color", "id": "pill_dot_color", "label": "Eyebrow dot", "default": "#B5C99A" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#D88B6D" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#2F3326" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "unit": "px", "min": 0, "max": 180, "step": 4, "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "unit": "px", "min": 0, "max": 180, "step": 4, "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "unit": "px", "min": 0, "max": 140, "step": 4, "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "unit": "px", "min": 0, "max": 140, "step": 4, "default": 60 }
  ],
  "blocks": [
    {
      "type": "pal",
      "name": "Pal",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Pal" },
        {
          "type": "text",
          "id": "trait",
          "label": "Personality line",
          "info": "One line, and make it a kid a parent recognises — not a description of the animal."
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Something they'd say",
          "info": "Shown in a speech bubble. Short. In the Pal's own voice."
        },
        { "type": "richtext", "id": "body", "label": "Body" },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main photo",
          "info": "Shown large when this Pal is selected. Leave empty to use the variant's own image. A square crop works best."
        },
        { "type": "text", "id": "image_alt", "label": "Main photo alt text" },
