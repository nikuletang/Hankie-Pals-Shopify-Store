      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every Totterful product is built for the moment a child reaches for it without being asked. Good materials, a shape that makes sense to them, and nothing in the way of everyday independence."
